<script>
  // ── Tab data ──
  const TAB_META: Record<string, { table: string; rows: string; file: string }> = {
    skills:   { table: 'skills',   rows: '5 rows returned',   file: 'skills.sql'   },
    activity: { table: 'activity', rows: '365 rows returned', file: 'activity.sql' },
    writing:  { table: 'writing',  rows: '3 rows returned',   file: 'writing.sql'  },
    projects: { table: 'projects', rows: '2 rows returned',   file: 'projects.sql' },
  };

  let activeTab = 'skills';
  let resultShown: Record<string, boolean> = {};

  // ── Switch tab ──
  function switchTab(tab: string) {
    if (tab === activeTab) return;
    activeTab = tab;

    // Update tab buttons
    document.querySelectorAll<HTMLElement>('.ide-tab').forEach(btn => {
      btn.classList.toggle('active', btn.dataset.tab === tab);
    });

    // Update editor content
    document.querySelectorAll<HTMLElement>('.ide-editor-content').forEach(el => {
      el.classList.toggle('active', el.dataset.content === tab);
    });

    // Update active table label
    const tblEl = document.getElementById('active-table');
    if (tblEl) tblEl.textContent = TAB_META[tab].table;

    // Update status bar
    const statusEl = document.getElementById('status-active-tab');
    if (statusEl) statusEl.textContent = TAB_META[tab].file;

    // Update explorer highlight
    document.querySelectorAll<HTMLElement>('[data-explorer-tab]').forEach(el => {
      el.classList.toggle('active', el.dataset.explorerTab === tab);
    });

    // If result was previously shown for this tab, keep it visible
    if (resultShown[tab]) {
      showResult(tab);
    } else {
      hideAllResults();
    }
  }

  // ── Show result ──
  function showResult(tab: string) {
    document.getElementById('results-empty')!.style.display = 'none';
    document.querySelectorAll<HTMLElement>('.ide-result-content').forEach(el => {
      const isTarget = el.dataset.result === tab;
      el.classList.toggle('visible', isTarget);
      if (!isTarget) el.style.display = 'none';
      else el.style.display = '';
    });

    // Row label
    const label = document.getElementById('result-row-label');
    if (label) {
      label.textContent = '· ' + TAB_META[tab].rows;
      label.style.color = 'rgba(52,211,153,.7)';
    }
  }

  function hideAllResults() {
    document.querySelectorAll<HTMLElement>('.ide-result-content').forEach(el => {
      el.classList.remove('visible');
      el.style.display = 'none';
    });
    const empty = document.getElementById('results-empty');
    if (empty) empty.style.display = '';
    const label = document.getElementById('result-row-label');
    if (label) { label.textContent = ''; label.style.color = 'rgba(52,211,153,0)'; }
  }

  // ── Run button ──
  const runBtn = document.getElementById('run-btn');
  runBtn?.addEventListener('click', () => {
    runBtn.classList.add('running');
    runBtn.innerHTML = `<svg viewBox="0 0 16 16" style="width:10px;height:10px;fill:currentColor;animation:spin .6s linear infinite;"><path d="M8 2a6 6 0 100 12A6 6 0 008 2zm0 1a5 5 0 110 10A5 5 0 018 3zm-.5 2.5v3l2.5 1.5.5-.87-2-.5-2 .5V5.5h-.5z" opacity=".5"/></svg> Running...`;

    setTimeout(() => {
      resultShown[activeTab] = true;
      showResult(activeTab);
      runBtn.classList.remove('running');
      runBtn.innerHTML = `<svg viewBox="0 0 16 16" style="width:10px;height:10px;fill:currentColor;"><path d="M4 2l10 6-10 6z"/></svg> Run Query`;
    }, 820);
  });

  // ── Tab click ──
  document.querySelectorAll<HTMLElement>('.ide-tab').forEach(btn => {
    btn.addEventListener('click', () => switchTab(btn.dataset.tab!));
  });

  // ── Explorer item click ──
  document.querySelectorAll<HTMLElement>('[data-explorer-tab]').forEach(el => {
    el.addEventListener('click', () => switchTab(el.dataset.explorerTab!));
  });

  // ── View toggle (card / table) ──
  const btnCard  = document.getElementById('btn-card');
  const btnTable = document.getElementById('btn-table');

  function setView(view: 'card' | 'table') {
    btnCard?.classList.toggle('active',  view === 'card');
    btnTable?.classList.toggle('active', view === 'table');
    document.querySelectorAll<HTMLElement>('.result-view-card').forEach(el => {
      el.classList.toggle('active', view === 'card');
    });
    document.querySelectorAll<HTMLElement>('.result-view-table').forEach(el => {
      el.classList.toggle('active', view === 'table');
    });
  }

  btnCard?.addEventListener('click',  () => setView('card'));
  btnTable?.addEventListener('click', () => setView('table'));

  // ── Profile popup toggle ──
  const profileTrigger = document.getElementById('profile-trigger');
  const profilePopup   = document.getElementById('profile-popup');
  profileTrigger?.addEventListener('click', (e) => {
    e.stopPropagation();
    profilePopup?.classList.toggle('open');
  });
  document.addEventListener('click', () => {
    profilePopup?.classList.remove('open');
  });
  profilePopup?.addEventListener('click', (e) => e.stopPropagation());

  // ── ER Diagram interactions ──
  const BLUE = '#3b82f6';
  const ER_ITEMS = [
    { dim: 'dim-skills',   rect: 'rect-skills',   line: 'line-skills',   lbl: 'lbl-skills',   fk: 'fk-skills',   tab: 'skills'   },
    { dim: 'dim-projects', rect: 'rect-projects', line: 'line-projects', lbl: 'lbl-projects', fk: 'fk-projects', tab: 'projects' },
    { dim: 'dim-writing',  rect: 'rect-writing',  line: 'line-writing',  lbl: 'lbl-writing',  fk: 'fk-writing',  tab: 'writing'  },
    { dim: 'dim-activity', rect: 'rect-activity', line: 'line-activity', lbl: 'lbl-activity', fk: 'fk-activity', tab: 'activity' },
  ];

  ER_ITEMS.forEach(({ dim, rect, line, lbl, fk, tab }) => {
    const dimEl  = document.getElementById(dim);
    const rectEl = document.getElementById(rect);
    const lineEl = document.getElementById(line);
    const lblEl  = document.getElementById(lbl);
    const fkEl   = document.getElementById(fk);
    if (!dimEl) return;

    dimEl.addEventListener('mouseenter', () => {
      rectEl?.setAttribute('stroke', BLUE);
      lineEl?.setAttribute('stroke', BLUE);
      lblEl?.setAttribute('fill', BLUE);
      fkEl?.querySelectorAll('text').forEach(t => t.setAttribute('fill', BLUE));
    });
    dimEl.addEventListener('mouseleave', () => {
      rectEl?.setAttribute('stroke', '#30363d');
      lineEl?.setAttribute('stroke', '#30363d');
      lblEl?.setAttribute('fill', '#8b949e');
      fkEl?.querySelectorAll('text').forEach((t, i) => {
        t.setAttribute('fill', i === 0 ? '#6a9955' : i === 1 ? '#9cdcfe' : '#8b949e');
      });
    });
    dimEl.addEventListener('click', () => switchTab(tab));
  });

  // ── ER line animation on load ──
  const lineLengths: Record<string, number> = {
    'line-skills':   43,
    'line-activity': 40,
    'line-projects': 40,
    'line-writing':  40,
  };
  Object.entries(lineLengths).forEach(([id, len]) => {
    const el = document.getElementById(id);
    if (el) {
      el.setAttribute('stroke-dasharray', String(len));
      el.setAttribute('stroke-dashoffset', String(len));
    }
  });
  const svg = document.getElementById('schema-svg');
  let linesDrawn = false;
  if (svg) {
    new IntersectionObserver(([entry]) => {
      if (!entry.isIntersecting || linesDrawn) return;
      linesDrawn = true;
      ['line-skills','line-projects','line-writing','line-activity'].forEach((id, i) => {
        setTimeout(() => {
          const line = document.getElementById(id) as SVGLineElement | null;
          const lbl  = document.getElementById(id.replace('line-', 'lbl-'));
          if (line) {
            line.style.transition = 'stroke-dashoffset 0.5s cubic-bezier(0.4,0,0.2,1)';
            line.style.strokeDashoffset = '0';
          }
          if (lbl) {
            lbl.style.transition = 'opacity 0.3s ease';
            lbl.setAttribute('opacity', '1');
          }
        }, i * 130);
      });
    }, { threshold: 0.2 }).observe(svg);
  }

  // ── Clock ──
  function updateClock() {
    const now = new Date();
    const hh = String(now.getHours()).padStart(2,'0');
    const mm = String(now.getMinutes()).padStart(2,'0');
    const ss = String(now.getSeconds()).padStart(2,'0');
    const el = document.getElementById('clock');
    if (el) el.textContent = `${hh}:${mm}:${ss}`;
  }
  updateClock();
  setInterval(updateClock, 1000);

  // ── Auto-run first tab on page load ──
  setTimeout(() => {
    resultShown['skills'] = true;
    showResult('skills');
  }, 1200);

  // ── Mobile: override fixed height ──
  const ideWindow = document.getElementById('ide-window');
  function applyMobileLayout() {
    if (!ideWindow) return;
    if (window.innerWidth < 768) {
      ideWindow.style.height = 'auto';
      ideWindow.style.minHeight = 'unset';
    } else {
      ideWindow.style.height = 'calc(100vh - 2rem)';
      ideWindow.style.minHeight = '580px';
    }
  }
  applyMobileLayout();
  window.addEventListener('resize', applyMobileLayout);
</script>

</Layout>
