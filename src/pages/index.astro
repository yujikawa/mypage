<script>
  document.querySelectorAll<HTMLElement>('.sql-connector').forEach(connector => {
    const result = connector.nextElementSibling as HTMLElement | null;
    if (!result) return;
    const arrow = connector.querySelector<HTMLElement>('span:first-child');
    const text  = connector.querySelector<HTMLElement>('span:last-child');
    const rows  = connector.dataset.rows ?? 'rows returned';

    // Add re-run button (hidden until after first run)
    const btn = document.createElement('button');
    btn.textContent = '⟳ re-run';
    btn.style.cssText = [
      'margin-left:auto',
      'padding:1px 8px',
      'border:1px solid #30363d',
      'border-radius:4px',
      'background:transparent',
      'color:#8b949e',
      'font-size:10px',
      'font-family:inherit',
      'cursor:pointer',
      'opacity:0',
      'transition:opacity 0.3s ease, color 0.2s, border-color 0.2s',
      'flex-shrink:0',
    ].join(';');
    btn.addEventListener('mouseenter', () => {
      btn.style.color = '#3b82f6';
      btn.style.borderColor = '#3b82f6';
    });
    btn.addEventListener('mouseleave', () => {
      btn.style.color = '#8b949e';
      btn.style.borderColor = '#30363d';
    });
    connector.appendChild(btn);

    // Core animation function
    function runAnimation() {
      // Reset
      if (arrow) { arrow.textContent = '▼'; arrow.style.color = ''; }
      if (text)  { text.textContent = 'executing...'; text.style.color = ''; }
      result!.style.transition = 'none';
      result!.style.opacity = '0';
      result!.style.transform = 'translateY(10px)';
      btn.style.opacity = '0';
      btn.style.pointerEvents = 'none';

      // Re-enable transition after reset frame
      requestAnimationFrame(() => {
        requestAnimationFrame(() => {
          result!.style.transition = 'opacity 0.55s ease, transform 0.55s ease';
        });
      });

      let dots = 0;
      const timer = setInterval(() => {
        if (text) text.textContent = 'executing' + '.'.repeat((dots++ % 3) + 1);
      }, 220);

      setTimeout(() => {
        clearInterval(timer);
        if (arrow) { arrow.textContent = '▶'; arrow.style.color = '#34d399'; }
        if (text)  { text.textContent = rows; text.style.color = '#6ee7b7'; }
        result!.style.opacity = '1';
        result!.style.transform = 'translateY(0)';
        btn.style.opacity = '1';
        btn.style.pointerEvents = 'auto';
      }, 1050);
    }

    btn.addEventListener('click', runAnimation);

    // Hide result block initially, trigger on scroll
    result.style.opacity = '0';
    result.style.transform = 'translateY(10px)';
    result.style.transition = 'opacity 0.55s ease, transform 0.55s ease';

    let triggered = false;
    new IntersectionObserver(([entry]) => {
      if (!entry.isIntersecting || triggered) return;
      triggered = true;
      runAnimation();
    }, { threshold: 0.2 }).observe(connector);
  });
</script>
