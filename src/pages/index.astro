  // ── Tab data ──
  const TAB_META: Record<string, { table: string; rows: string; file: string; error: boolean }> = {
    skills:   { table: 'skills',   rows: '5 rows returned',   file: 'skills.sql',   error: false },
    activity: { table: 'activity', rows: '365 rows returned', file: 'activity.sql', error: false },
    writing:  { table: 'writing',  rows: '3 rows returned',   file: 'writing.sql',  error: false },
    projects: { table: 'projects', rows: '4 rows returned',   file: 'projects.sql', error: false },
    salary:   { table: 'salary',   rows: '',                  file: 'salary.sql',   error: true  },
    repl:     { table: '',         rows: '',                  file: '>_ repl',       error: false },
  };

  // ── REPL: query processor ──
  type REPLResult =
    | { kind: 'table'; headers: string[]; rows: string[][]; total?: number }
    | { kind: 'error'; msg: string; hint?: string }
    | { kind: 'text';  msg: string };

  function escHtml(s: string) {
    return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
  }

  function processREPL(sql: string): REPLResult {
    const q = sql.trim().toLowerCase().replace(/\s+/g,' ');
    if (!q) return { kind:'error', msg:'ERROR: no query specified', hint:'HINT: Try  SELECT * FROM dim_engineer' };

    // Destructive ops
    if (/^(drop|delete|truncate|update|insert|alter|create)\b/.test(q))
      return { kind:'error', msg:'ERROR: permission denied\nDETAIL: This database is read-only.', hint:"HINT: The engineers table will not be dropped today. Nice try." };

    // Salary easter egg
    if (/\bsalary\b/.test(q))
      return { kind:'error', msg:'ERROR: column "salary" of relation "dim_engineer" does not exist', hint:"HINT: This column is classified. Access requires ROLE = 'hr_admin' or above.\n      Current role: 'analytics_engineer' — nice try 😏" };

    // Secrets
    if (/\bsecrets\b/.test(q))
      return { kind:'error', msg:'ERROR: permission denied\nDETAIL: relation "secrets" exists but content is classified.', hint:'HINT: Submit a pull request at github.com/yujikawa to gain access.' };

    // SHOW TABLES / \dt
    if (/^(show tables|\\dt)\s*;?$/.test(q))
      return { kind:'table', headers:['table_name','type','rows'], rows:[
        ['fact_daily_activity','FACT','365'],
        ['dim_engineer','DIMENSION','1'],
        ['dim_date','DIMENSION','365'],
        ['dim_skill','DIMENSION','5'],
        ['dim_platform','DIMENSION','3'],
        ['dim_project','DIMENSION','2'],
        ['fun_facts','VIEW','7'],
        ['secrets','???','???'],
      ]};

    // dim_engineer
    if (/from\s+dim_engineer\b/.test(q))
      return { kind:'table', headers:['engineer_id','name','role','location','years_exp'], rows:[
        ['1','Yuji','Analytics Engineer','Japan 🇯🇵','5+'],
      ]};

    // dim_skill
    if (/from\s+dim_skill\b/.test(q))
      return { kind:'table', headers:['skill_id','engineer_id','skill_name','category','proficiency'], rows:[
        ['1','1','Data Modeling','Analytics Eng','expert'],
        ['2','1','dbt','Analytics Eng','expert'],
        ['3','1','SQL','Query Language','expert'],
        ['4','1','Python','Programming','proficient'],
        ['5','1','BigQuery','Data Warehouse','proficient'],
      ]};

    // dim_platform
    if (/from\s+dim_platform\b/.test(q))
      return { kind:'table', headers:['platform_id','engineer_id','platform','url'], rows:[
        ['1','1','qiita','https://qiita.com/yujikawa'],
        ['2','1','zenn','https://zenn.dev/yujikawa'],
        ['3','1','medium','https://medium.com/@yujikawa'],
      ]};

    // dim_project
    if (/from\s+dim_project\b/.test(q))
      return { kind:'table', headers:['project_id','engineer_id','title','description'], rows:[
        ['1','1','Modaryn','Analyzes dbt projects to score model complexity'],
        ['2','1','Modscape','YAML-driven data modeling visualizer'],
        ['3','1','clipable','Converts spreadsheet clipboard data into a Markdown table instantly'],
      ]};

    // fact_daily_activity
    if (/from\s+fact_daily_activity\b/.test(q))
      return { kind:'table', total:365, headers:['activity_id','engineer_id','date_id','contributions'], rows:[
        ['365','1','20260320','12'],
        ['364','1','20260319','7'],
        ['363','1','20260318','3'],
        ['362','1','20260317','15'],
        ['361','1','20260316','0'],
      ]};

    // dim_date
    if (/from\s+dim_date\b/.test(q))
      return { kind:'table', total:365, headers:['date_id','date','year','month','day_of_week'], rows:[
        ['20260320','2026-03-20','2026','3','Friday'],
        ['20260319','2026-03-19','2026','3','Thursday'],
        ['20260318','2026-03-18','2026','3','Wednesday'],
        ['20260317','2026-03-17','2026','3','Tuesday'],
        ['20260316','2026-03-16','2026','3','Monday'],
      ]};

    // fun_facts
    if (/fun_fact/.test(q))
      return { kind:'table', headers:['key','value'], rows:[
        ['origin','Excel → SQL → dbt → never looked back'],
        ['coffee_per_day','3 ☕'],
        ['favorite_join','LEFT JOIN'],
        ['tabs_vs_spaces','spaces, 2 of them'],
        ['debug_method','EXPLAIN ANALYZE'],
        ['philosophy','clean data > clean code'],
        ['bug_count','0 (allegedly)'],
      ]};

    // SELECT 1
    if (/^select 1\s*;?$/.test(q))
      return { kind:'table', headers:['?column?'], rows:[['1']] };

    // NOW() / CURRENT_TIMESTAMP
    if (/\b(now\s*\(\)|current_timestamp)\b/.test(q))
      return { kind:'table', headers:['now'], rows:[[new Date().toISOString()]] };

    // version()
    if (/\bversion\s*\(\)/.test(q))
      return { kind:'table', headers:['version'], rows:[['mypage.sql 2.0.0 on portfolio_db, compiled by Yuji']] };

    // EXPLAIN
    if (/^explain\b/.test(q))
      return { kind:'text', msg:'Seq Scan on dim_engineer  (cost=0.00..0.01 rows=1 width=72)\n  Filter: ((name)::text = \'Yuji\'::text)\nPlanning time: 0.042 ms\nExecution time: 0.021 ms' };

    // Unknown relation
    const tblMatch = q.match(/from\s+([a-z_][a-z0-9_]*)/);
    if (tblMatch)
      return { kind:'error', msg:`ERROR: relation "${escHtml(tblMatch[1])}" does not exist`, hint:'HINT: Run SHOW TABLES to see available relations.' };

    return { kind:'error', msg:'ERROR: syntax error at or near the query', hint:'HINT: Try  SELECT * FROM dim_engineer' };
  }

  function renderREPLResult(result: REPLResult) {
    const container = document.querySelector<HTMLElement>('[data-result="repl"]')!;
    const inner     = document.getElementById('repl-result-inner')!;
    const label     = document.getElementById('result-row-label');
    const statusBar = document.querySelector<HTMLElement>('.ide-statusbar');

    document.getElementById('results-empty')!.style.display = 'none';
    document.querySelectorAll<HTMLElement>('.ide-result-content').forEach(el => {
      if (el.dataset.result !== 'repl') { el.classList.remove('visible'); el.style.display = 'none'; }
    });
    container.style.display = '';
    container.classList.add('visible');

    // Reset scroll position
    const scrollPane = container.closest<HTMLElement>('[style*="overflow:auto"]') ?? container.parentElement;
    if (scrollPane) scrollPane.scrollTop = 0;

    if (result.kind === 'error') {
      inner.innerHTML = '<div style="padding:20px 24px;"><div style="background:rgba(220,38,38,.08);border:1px solid rgba(220,38,38,.3);border-radius:6px;padding:16px 20px;"><div style="display:flex;align-items:center;gap:10px;margin-bottom:10px;"><svg viewBox="0 0 16 16" style="width:16px;height:16px;fill:#f87171;flex-shrink:0;"><path d="M8 1a7 7 0 100 14A7 7 0 008 1zm.75 4a.75.75 0 00-1.5 0v3.5a.75.75 0 001.5 0V5zm-.75 6.5a.75.75 0 100-1.5.75.75 0 000 1.5z"/></svg><span style="color:#f87171;font-family:\'JetBrains Mono\',monospace;font-size:13px;font-weight:600;">' + escHtml(result.msg.split('\n')[0]) + '</span></div><pre style="font-family:\'JetBrains Mono\',monospace;font-size:11px;line-height:1.7;color:rgba(248,113,113,.75);margin:0;white-space:pre-wrap;">' + escHtml(result.msg) + (result.hint ? '\n' + result.hint : '') + '</pre></div><div style="color:rgba(139,148,158,.35);font-family:\'JetBrains Mono\',monospace;font-size:10px;margin-top:10px;">Execution time: 0ms · 0 rows returned · Query failed</div></div>';
      if (label) { label.textContent = '· ERROR'; label.style.color = '#f87171'; }
      if (statusBar) statusBar.style.borderTop = '1px solid rgba(220,38,38,.4)';
    } else if (result.kind === 'table') {
      const shown = result.rows.length;
      const total = result.total ?? shown;
      const thStyle  = `text-align:left;padding:7px 14px;font-family:'JetBrains Mono',monospace;font-size:10px;font-weight:normal;color:rgba(139,148,158,.5);background:#161b22;border-bottom:1px solid #21262d;position:sticky;top:0;z-index:1;white-space:nowrap;`;
      const tdStyle  = `padding:6px 14px;font-family:'JetBrains Mono',monospace;font-size:11px;border-bottom:1px solid rgba(33,38,45,.5);white-space:nowrap;`;
      const numStyle = `color:rgba(139,148,158,.2);width:36px;`;
      const thead = `<tr><th style="${thStyle}${numStyle}">#</th>${result.headers.map(h => `<th style="${thStyle}">${escHtml(h)}</th>`).join('')}</tr>`;
      const tbody = result.rows.map((row, i) =>
        `<tr><td style="${tdStyle}${numStyle}">${i + 1}</td>${row.map(c => `<td style="${tdStyle}">${escHtml(c)}</td>`).join('')}</tr>`
      ).join('');
      const note = total > shown ? ` · showing ${shown} of ${total}` : '';
      inner.innerHTML = '<div style="overflow-x:auto;"><table style="width:100%;border-collapse:collapse;"><thead>' + thead + '</thead><tbody>' + tbody + '</tbody></table></div><div style="padding:8px 14px;font-family:\'JetBrains Mono\',monospace;font-size:10px;color:rgba(139,148,158,.35);border-top:1px solid rgba(33,38,45,.5);">' + total + ' row' + (total !== 1 ? 's' : '') + ' returned' + note + '</div>';
      if (label) { label.textContent = `· ${total} rows returned`; label.style.color = 'rgba(52,211,153,.7)'; }
      if (statusBar) statusBar.style.borderTop = '';
    } else {
      inner.innerHTML = '<div style="padding:20px 24px;"><pre style="font-family:\'JetBrains Mono\',monospace;font-size:11px;line-height:1.7;color:rgba(139,148,158,.65);margin:0;white-space:pre-wrap;">' + escHtml(result.msg) + '</pre></div>';
      if (label) { label.textContent = ''; label.style.color = 'rgba(52,211,153,0)'; }
      if (statusBar) statusBar.style.borderTop = '';
    }
  }

  let activeTab = 'skills';
  let resultShown: Record<string, boolean> = {};

  // ── Switch tab ──
  function switchTab(tab: string) {
    if (tab === activeTab) return;
    activeTab = tab;

    // Update tab buttons
    document.querySelectorAll<HTMLElement>('.ide-tab').forEach(btn => {
      btn.classList.toggle('active', btn.dataset.tab === tab);
    });

    // Update editor content
    document.querySelectorAll<HTMLElement>('.ide-editor-content').forEach(el => {
      el.classList.toggle('active', el.dataset.content === tab);
    });

    // Update active table label
    const tblEl = document.getElementById('active-table');
    if (tblEl) tblEl.textContent = TAB_META[tab].table;

    // Update status bar
    const statusEl = document.getElementById('status-active-tab');
    if (statusEl) statusEl.textContent = TAB_META[tab].file;

    // Update explorer highlight
    document.querySelectorAll<HTMLElement>('[data-explorer-tab]').forEach(el => {
      el.classList.toggle('active', el.dataset.explorerTab === tab);
    });

    // If result was previously shown for this tab, keep it visible
    if (resultShown[tab]) {
      showResult(tab);
    } else {
      hideAllResults();
    }
  }

  // ── Show result ──
  function showResult(tab: string) {
    const meta = TAB_META[tab];
    document.getElementById('results-empty')!.style.display = 'none';
    document.querySelectorAll<HTMLElement>('.ide-result-content').forEach(el => {
      const isTarget = el.dataset.result === tab;
      el.classList.toggle('visible', isTarget);
      if (!isTarget) el.style.display = 'none';
      else el.style.display = '';
    });

    // Row label + status bar color
    const label = document.getElementById('result-row-label');
    const statusBar = document.querySelector<HTMLElement>('.ide-statusbar');
    if (meta.error) {
      if (label) { label.textContent = '· ERROR: permission denied'; label.style.color = '#f87171'; }
      if (statusBar) statusBar.style.borderTop = '1px solid rgba(220,38,38,.4)';
    } else {
      if (label) { label.textContent = '· ' + t(`rows-${tab}`); label.style.color = 'rgba(52,211,153,.7)'; }
      if (statusBar) statusBar.style.borderTop = '';
    }
  }

  function hideAllResults() {
    document.querySelectorAll<HTMLElement>('.ide-result-content').forEach(el => {
      el.classList.remove('visible');
      el.style.display = 'none';
    });
    const empty = document.getElementById('results-empty');
    if (empty) empty.style.display = '';
    const label = document.getElementById('result-row-label');
    if (label) { label.textContent = ''; label.style.color = 'rgba(52,211,153,0)'; }
    const statusBar = document.querySelector<HTMLElement>('.ide-statusbar');
    if (statusBar) statusBar.style.borderTop = '';
  }

  // ── Run button ──
  const runBtn = document.getElementById('run-btn');
  function executeRun() {
    if (!runBtn) return;
    runBtn.classList.add('running');
    runBtn.innerHTML = `<svg viewBox="0 0 16 16" style="width:10px;height:10px;fill:currentColor;animation:spin .6s linear infinite;"><path d="M8 2a6 6 0 100 12A6 6 0 008 2zm0 1a5 5 0 110 10A5 5 0 018 3zm-.5 2.5v3l2.5 1.5.5-.87-2-.5-2 .5V5.5h-.5z" opacity=".5"/></svg> ${t('running')}`;

    if (activeTab === 'repl') {
      const input = (document.getElementById('repl-input') as HTMLTextAreaElement)?.value ?? '';
      setTimeout(() => {
        const result = processREPL(input);
        renderREPLResult(result);
        runBtn.classList.remove('running');
        if (result.kind === 'error') {
          runBtn.style.background = 'rgba(220,38,38,.15)';
          runBtn.style.borderColor = 'rgba(220,38,38,.4)';
          runBtn.style.color = '#f87171';
          runBtn.innerHTML = `<svg viewBox="0 0 16 16" style="width:10px;height:10px;fill:currentColor;"><path d="M8 1a7 7 0 100 14A7 7 0 008 1zm.75 4a.75.75 0 00-1.5 0v3.5a.75.75 0 001.5 0V5zm-.75 6.5a.75.75 0 100-1.5.75.75 0 000 1.5z"/></svg> ${t('error-btn')}`;
          setTimeout(() => {
            runBtn.style.background = '';
            runBtn.style.borderColor = '';
            runBtn.style.color = '';
            runBtn.innerHTML = `<svg viewBox="0 0 16 16" style="width:10px;height:10px;fill:currentColor;"><path d="M4 2l10 6-10 6z"/></svg> ${t('run-btn')}`;
          }, 2500);
        } else {
          runBtn.innerHTML = `<svg viewBox="0 0 16 16" style="width:10px;height:10px;fill:currentColor;"><path d="M4 2l10 6-10 6z"/></svg> ${t('run-btn')}`;
        }
      }, 500);
      return;
    }

    setTimeout(() => {
      resultShown[activeTab] = true;
      showResult(activeTab);
      runBtn.classList.remove('running');
      if (TAB_META[activeTab].error) {
        runBtn.style.background = 'rgba(220,38,38,.15)';
        runBtn.style.borderColor = 'rgba(220,38,38,.4)';
        runBtn.style.color = '#f87171';
        runBtn.innerHTML = `<svg viewBox="0 0 16 16" style="width:10px;height:10px;fill:currentColor;"><path d="M8 1a7 7 0 100 14A7 7 0 008 1zm.75 4a.75.75 0 00-1.5 0v3.5a.75.75 0 001.5 0V5zm-.75 6.5a.75.75 0 100-1.5.75.75 0 000 1.5z"/></svg> ${t('error-btn')}`;
        setTimeout(() => {
          runBtn.style.background = '';
          runBtn.style.borderColor = '';
          runBtn.style.color = '';
          runBtn.innerHTML = `<svg viewBox="0 0 16 16" style="width:10px;height:10px;fill:currentColor;"><path d="M4 2l10 6-10 6z"/></svg> ${t('run-btn')}`;
        }, 2500);
      } else {
        runBtn.innerHTML = `<svg viewBox="0 0 16 16" style="width:10px;height:10px;fill:currentColor;"><path d="M4 2l10 6-10 6z"/></svg> ${t('run-btn')}`;
      }
    }, 820);
  }

  runBtn?.addEventListener('click', executeRun);

  // Ctrl+Enter anywhere in the editor pane runs the query
  document.querySelector<HTMLElement>('.ide-editor-pane')?.addEventListener('keydown', (e) => {
    const ke = e as KeyboardEvent;
    if ((ke.ctrlKey || ke.metaKey) && ke.key === 'Enter') {
      ke.preventDefault();
      executeRun();
    }
  });

  // ── Tab click ──
  document.querySelectorAll<HTMLElement>('.ide-tab').forEach(btn => {
    btn.addEventListener('click', () => switchTab(btn.dataset.tab!));
  });

  // ── Explorer item click ──
  document.querySelectorAll<HTMLElement>('[data-explorer-tab]').forEach(el => {
    el.addEventListener('click', () => switchTab(el.dataset.explorerTab!));
  });

  // ── View toggle (card / table) ──
  const btnCard  = document.getElementById('btn-card');
  const btnTable = document.getElementById('btn-table');

  function setView(view: 'card' | 'table') {
    btnCard?.classList.toggle('active',  view === 'card');
    btnTable?.classList.toggle('active', view === 'table');
    document.querySelectorAll<HTMLElement>('.result-view-card').forEach(el => {
      el.classList.toggle('active', view === 'card');
    });
    document.querySelectorAll<HTMLElement>('.result-view-table').forEach(el => {
      el.classList.toggle('active', view === 'table');
    });
  }

  btnCard?.addEventListener('click',  () => setView('card'));
  btnTable?.addEventListener('click', () => setView('table'));

  // ── Profile popup toggle ──
  const profileTrigger = document.getElementById('profile-trigger');
  const profilePopup   = document.getElementById('profile-popup');
  profileTrigger?.addEventListener('click', (e) => {
    e.stopPropagation();
    profilePopup?.classList.toggle('open');
  });
  document.addEventListener('click', () => {
    profilePopup?.classList.remove('open');
  });
  profilePopup?.addEventListener('click', (e) => e.stopPropagation());

  // ── DDL inspect ──
  function showDDL(tableId: string) {
    const emptyEl = document.getElementById('results-empty');
    if (emptyEl) emptyEl.style.display = 'none';
    document.querySelectorAll<HTMLElement>('.ide-result-content').forEach(el => {
      const isTarget = el.dataset.result === `ddl-${tableId}`;
      if (isTarget) {
        el.classList.add('visible');
        el.style.display = '';
      } else {
        el.classList.remove('visible');
        el.style.display = 'none';
      }
    });
    // スクロールを先頭に戻す
    const scroller = document.querySelector<HTMLElement>('.ide-results-pane > div');
    if (scroller) scroller.scrollTop = 0;
    const label = document.getElementById('result-row-label');
    if (label) { label.textContent = `· ${tableId}`; label.style.color = 'rgba(78,201,176,.7)'; }
    const statusEl = document.getElementById('status-active-tab');
    if (statusEl) statusEl.textContent = tableId;
    const statusBar = document.querySelector<HTMLElement>('.ide-statusbar');
    if (statusBar) statusBar.style.borderTop = '';
  }

  // ── ER Diagram interactions ──
  const BLUE = '#3b82f6';
  const ER_ITEMS = [
    { dim: 'dim-skill',    rect: 'rect-skill',    line: 'line-skill',    lbl: 'lbl-skill',    fk: 'fk-skill',    ddl: 'dim_skill'    },
    { dim: 'dim-platform', rect: 'rect-platform', line: 'line-platform', lbl: 'lbl-platform', fk: 'fk-platform', ddl: 'dim_platform' },
    { dim: 'dim-project',  rect: 'rect-project',  line: 'line-project',  lbl: 'lbl-project',  fk: 'fk-project',  ddl: 'dim_project'  },
    { dim: 'dim-date',     rect: 'rect-date',     line: 'line-date',     lbl: 'lbl-date',     fk: 'fk-date',     ddl: 'dim_date'     },
  ];

  ER_ITEMS.forEach(({ dim, rect, line, lbl, fk, ddl }) => {
    const dimEl  = document.getElementById(dim);
    const rectEl = document.getElementById(rect);
    const lineEl = document.getElementById(line);
    const lblEl  = document.getElementById(lbl);
    const fkEl   = document.getElementById(fk);
    if (!dimEl) return;

    dimEl.addEventListener('mouseenter', () => {
      rectEl?.setAttribute('stroke', BLUE);
      lineEl?.setAttribute('stroke', BLUE);
      lblEl?.setAttribute('fill', BLUE);
      fkEl?.querySelectorAll('text').forEach(t => t.setAttribute('fill', BLUE));
    });
    dimEl.addEventListener('mouseleave', () => {
      rectEl?.setAttribute('stroke', '#30363d');
      lineEl?.setAttribute('stroke', '#30363d');
      lblEl?.setAttribute('fill', '#8b949e');
      fkEl?.querySelectorAll('text').forEach((t, i) => {
        t.setAttribute('fill', i === 0 ? '#6a9955' : i === 1 ? '#9cdcfe' : '#8b949e');
      });
    });
    dimEl.addEventListener('click', () => showDDL(ddl));
  });

  // fact_engineer と dim_engineer のhover + DDL表示
  const dimFactEl     = document.getElementById('dim-fact');
  const dimEngineerEl = document.getElementById('dim-engineer');
  const rectFactEl    = document.getElementById('rect-fact');
  const rectEngineerEl = document.getElementById('rect-engineer');
  const lineEngineerEl = document.getElementById('line-engineer');
  const lblEngineerEl  = document.getElementById('lbl-engineer');

  dimFactEl?.addEventListener('mouseenter', () => {
    rectFactEl?.setAttribute('stroke', BLUE);
    lineEngineerEl?.setAttribute('stroke', BLUE);
  });
  dimFactEl?.addEventListener('mouseleave', () => {
    rectFactEl?.setAttribute('stroke', '#3b82f6');
    lineEngineerEl?.setAttribute('stroke', '#30363d');
  });
  dimFactEl?.addEventListener('click', () => showDDL('fact_daily_activity'));

  dimEngineerEl?.addEventListener('mouseenter', () => {
    rectEngineerEl?.setAttribute('stroke', BLUE);
    lineEngineerEl?.setAttribute('stroke', BLUE);
    lblEngineerEl?.setAttribute('fill', BLUE);
  });
  dimEngineerEl?.addEventListener('mouseleave', () => {
    rectEngineerEl?.setAttribute('stroke', '#30363d');
    lineEngineerEl?.setAttribute('stroke', '#30363d');
    lblEngineerEl?.setAttribute('fill', '#8b949e');
  });
  dimEngineerEl?.addEventListener('click', () => showDDL('dim_engineer'));

  // ── ER line animation on load ──
  const lineLengths: Record<string, number> = {
    'line-skill':    175,
    'line-platform':  48,
    'line-project':  175,
    'line-engineer':  44,
    'line-date':      72,
  };
  Object.entries(lineLengths).forEach(([id, len]) => {
    const el = document.getElementById(id);
    if (el) {
      el.setAttribute('stroke-dasharray', String(len));
      el.setAttribute('stroke-dashoffset', String(len));
    }
  });
  const svg = document.getElementById('schema-svg');
  let linesDrawn = false;
  if (svg) {
    new IntersectionObserver(([entry]) => {
      if (!entry.isIntersecting || linesDrawn) return;
      linesDrawn = true;
      ['line-skill','line-platform','line-project','line-engineer','line-date'].forEach((id, i) => {
        setTimeout(() => {
          const line = document.getElementById(id) as SVGLineElement | null;
          const lbl  = document.getElementById(id.replace('line-', 'lbl-'));
          if (line) {
            line.style.transition = 'stroke-dashoffset 0.5s cubic-bezier(0.4,0,0.2,1)';
            line.style.strokeDashoffset = '0';
          }
          if (lbl) {
            lbl.style.transition = 'opacity 0.3s ease';
            lbl.setAttribute('opacity', '1');
          }
        }, i * 130);
      });
    }, { threshold: 0.2 }).observe(svg);
  }

  // ── Clock ──
  function updateClock() {
    const now = new Date();
    const hh = String(now.getHours()).padStart(2,'0');
    const mm = String(now.getMinutes()).padStart(2,'0');
    const ss = String(now.getSeconds()).padStart(2,'0');
    const el = document.getElementById('clock');
    if (el) el.textContent = `${hh}:${mm}:${ss}`;
  }
  updateClock();
  setInterval(updateClock, 1000);

  // ── Auto-run first tab on page load ──
  setTimeout(() => {
    resultShown['skills'] = true;
    showResult('skills');
  }, 1200);

  // ── Mobile: override fixed height ──
  const ideWindow = document.getElementById('ide-window');
  function applyMobileLayout() {
    if (!ideWindow) return;
    if (window.innerWidth < 768) {
      ideWindow.style.height = 'auto';
      ideWindow.style.minHeight = 'unset';
    } else {
      ideWindow.style.height = 'calc(100vh - 2rem)';
      ideWindow.style.minHeight = '580px';
    }
  }
  applyMobileLayout();
  window.addEventListener('resize', applyMobileLayout);

  // ── Language toggle ──
  document.querySelectorAll<HTMLElement>('.lang-btn').forEach(btn => {
    btn.addEventListener('click', () => setLang(btn.dataset.lang as Lang));
  });
  // Apply saved language on load
  setLang(currentLang);
</script>

</Layout>
