---
import Layout from '../layouts/Layout.astro';
import AnimateOnScroll from '../components/AnimateOnScroll.astro';

const featuredProjects = [
  {
    title: "Modaryn",
    slug: "modaryn",
    description: "Analyzes dbt projects to score model complexity and structural importance.",
    link: "https://github.com/yujikawa/modaryn",
    tags: ["Python", "dbt", "CLI"],
  },
  {
    title: "Modscape",
    slug: "modscape",
    description: "A YAML-driven data modeling visualizer bridging conceptual and physical models.",
    link: "https://github.com/yujikawa/modscape",
    tags: ["Python", "YAML", "Data Modeling"],
  },
];

const skills = ["dbt", "SQL", "Python", "BigQuery", "Snowflake", "Spark", "Airflow"];
---

<Layout title="Welcome">
  <main class="min-h-screen pt-24 pb-20">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">

      <!-- ═══════════════════════════════════════════ -->
      <!-- HERO: SQL query + ER entity result         -->
      <!-- ═══════════════════════════════════════════ -->
      <section class="py-12 md:py-16 animate-slide-up">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">

          <!-- SQL Terminal -->
          <div class="rounded-xl border border-border-color bg-background-alt overflow-hidden shadow-xl">
            <!-- Window chrome -->
            <div class="flex items-center gap-1.5 px-4 py-2.5 border-b border-border-color bg-background/80">
              <div class="h-2.5 w-2.5 rounded-full bg-red-500/50"></div>
              <div class="h-2.5 w-2.5 rounded-full bg-yellow-500/50"></div>
              <div class="h-2.5 w-2.5 rounded-full bg-green-500/50"></div>
              <span class="mono text-xs text-text-muted/40 ml-2">psql — yuji@analytics</span>
            </div>
            <!-- Query body -->
            <div class="p-5 mono text-sm leading-7">
              <div class="sql-cmt mb-2">-- who is this?</div>
              <div><span class="sql-kw">SELECT</span></div>
              <div class="pl-6"><span class="sql-col">name</span><span class="text-text-muted">,</span></div>
              <div class="pl-6"><span class="sql-col">role</span><span class="text-text-muted">,</span></div>
              <div class="pl-6"><span class="sql-col">location</span><span class="text-text-muted">,</span></div>
              <div class="pl-6"><span class="sql-col">stack</span><span class="text-text-muted">,</span></div>
              <div class="pl-6"><span class="sql-col">status</span></div>
              <div><span class="sql-kw">FROM</span>   <span class="sql-tbl">engineers</span></div>
              <div><span class="sql-kw">WHERE</span>  <span class="sql-col">passion</span> <span class="text-text-muted/60">=</span> <span class="sql-str">'data'</span></div>
              <div><span class="sql-kw">LIMIT</span>  <span class="sql-num">1</span><span class="text-text-muted">;</span></div>
              <div class="mt-5 sql-cmt text-xs">-- 1 row returned (2ms) ✓</div>
            </div>
          </div>

          <!-- ER Entity: engineers -->
          <div class="rounded-xl border border-primary/30 bg-background-alt overflow-hidden shadow-xl shadow-primary/5">
            <!-- Table name header -->
            <div class="flex items-center gap-2 px-4 py-2.5 border-b border-primary/20 bg-primary/5">
              <span class="text-primary text-sm">⬡</span>
              <span class="mono text-sm font-bold text-primary">engineers</span>
              <span class="ml-auto mono text-xs text-text-muted/30">id: 1</span>
            </div>
            <!-- Profile row -->
            <div class="px-5 pt-4 pb-3 flex items-center gap-4 border-b border-border-color/50">
              <div class="relative flex-shrink-0">
                <div class="absolute inset-0 rounded-full animate-glow"></div>
                <img
                  class="relative h-14 w-14 rounded-full border border-primary/25 object-cover"
                  src="/mypage/icon.png"
                  alt="Yuji"
                />
                <div class="absolute bottom-0 right-0 h-3 w-3 rounded-full bg-emerald-400 border-2 border-background shadow-lg shadow-emerald-400/40"></div>
              </div>
              <div>
                <div class="text-text-base font-bold">Yuji</div>
                <div class="mono text-xs text-text-muted/50">Analytics Engineer</div>
              </div>
            </div>
            <!-- Fields -->
            <div class="px-5 py-3 space-y-2 border-b border-border-color/50">
              {[
                { col: "name",     val: "'Yuji'",     type: "str" },
                { col: "role",     val: "'Analytics Engineer'", type: "str" },
                { col: "location", val: "'Japan'",             type: "str" },
                { col: "stack",    val: "ARRAY[...]",          type: "kw"  },
                { col: "status",   val: "● active",            type: "ok"  },
              ].map(({ col, val, type }) => (
                <div class="flex items-start gap-3 mono text-xs">
                  <span class="sql-col w-20 flex-shrink-0">{col}</span>
                  <span class="text-border-color">│</span>
                  <span class={
                    type === "str" ? "sql-str" :
                    type === "kw"  ? "sql-kw"  :
                    "text-emerald-400"
                  }>{val}</span>
                </div>
              ))}
            </div>
            <!-- Skills -->
            <div class="px-5 py-3 flex flex-wrap gap-1.5 border-b border-border-color/50">
              {skills.map(skill => (
                <span class="mono px-2 py-0.5 text-xs text-accent/70 bg-accent/10 border border-accent/20 rounded">
                  {skill}
                </span>
              ))}
            </div>
            <!-- CTAs -->
            <div class="px-5 py-3 flex gap-2">
              <a
                href="https://medium.com/@yujikawa"
                target="_blank" rel="noopener noreferrer"
                class="flex-1 text-center px-3 py-2 bg-primary text-white text-xs font-semibold rounded-lg hover:bg-primary/85 transition-all shadow-md shadow-primary/20 flex items-center justify-center gap-1.5"
              >
                <svg viewBox="0 0 24 24" class="h-3.5 w-3.5" fill="currentColor"><path d="M13.54 12a6.8 6.8 0 01-6.77 6.82A6.8 6.8 0 010 12a6.8 6.8 0 016.77-6.82A6.8 6.8 0 0113.54 12zM20.96 12c0 3.54-1.51 6.42-3.38 6.42-1.87 0-3.39-2.88-3.39-6.42s1.52-6.42 3.39-6.42 3.38 2.88 3.38 6.42M24 12c0 3.17-.53 5.75-1.19 5.75-.66 0-1.19-2.58-1.19-5.75s.53-5.75 1.19-5.75C23.47 6.25 24 8.83 24 12z"/></svg>
                Medium
              </a>
              <a
                href="https://github.com/yujikawa"
                target="_blank" rel="noopener noreferrer"
                class="flex-1 text-center px-3 py-2 border border-border-color text-text-muted text-xs font-semibold rounded-lg hover:border-primary/40 hover:text-text-base transition-all flex items-center justify-center gap-1.5"
              >
                <svg viewBox="0 0 16 16" class="h-3.5 w-3.5" fill="currentColor"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38C13.71 14.53 16 11.54 16 8c0-4.42-3.58-8-8-8z"/></svg>
                GitHub
              </a>
            </div>
          </div>

        </div>
      </section>

      <!-- ═══════════════════════════════════════════ -->
      <!-- ACTIVITY                                    -->
      <!-- ═══════════════════════════════════════════ -->
      <AnimateOnScroll animation="slide-up" delay={0}>
        <section id="activity" class="py-12">
          <!-- SQL label -->
          <div class="mono text-xs text-text-muted/50 mb-3 flex flex-wrap gap-1 items-center">
            <span class="sql-kw">SELECT</span>
            <span class="sql-col">date</span><span class="text-text-muted">,</span>
            <span class="sql-col">contributions</span>
            <span class="sql-kw">FROM</span>
            <span class="sql-tbl">github_activity</span>
            <span class="sql-kw">WHERE</span>
            <span class="sql-col">user</span>
            <span class="text-text-muted/60">=</span>
            <span class="sql-str">'yujikawa'</span>
            <span class="sql-kw">ORDER BY</span>
            <span class="sql-col">date</span>
            <span class="sql-kw">DESC</span><span class="text-text-muted">;</span>
          </div>
          <!-- Result -->
          <div class="rounded-xl border border-border-color overflow-hidden shadow-xl">
            <div class="px-4 py-2 border-b border-border-color bg-background/80 mono text-xs text-text-muted/40 flex items-center gap-2">
              <span class="text-emerald-400">▶</span> 365 rows returned
            </div>
            <div class="p-6 bg-background-alt/50">
              <img
                class="mx-auto w-full max-w-2xl rounded-lg opacity-80 hover:opacity-100 transition-opacity duration-300"
                src="https://ghchart.rshah.org/3b82f6/yujikawa"
                alt="GitHub contribution chart"
              />
            </div>
          </div>
        </section>
      </AnimateOnScroll>

      <!-- ═══════════════════════════════════════════ -->
      <!-- WRITING                                     -->
      <!-- ═══════════════════════════════════════════ -->
      <AnimateOnScroll animation="slide-up" delay={0}>
        <section id="writing" class="py-12">
          <!-- SQL label -->
          <div class="mono text-xs text-text-muted/50 mb-3 flex flex-wrap gap-1 items-center">
            <span class="sql-kw">SELECT</span>
            <span class="sql-col">platform</span><span class="text-text-muted">,</span>
            <span class="sql-col">url</span><span class="text-text-muted">,</span>
            <span class="sql-col">topics</span>
            <span class="sql-kw">FROM</span>
            <span class="sql-tbl">writing</span>
            <span class="sql-kw">WHERE</span>
            <span class="sql-col">author</span>
            <span class="text-text-muted/60">=</span>
            <span class="sql-str">'yujikawa'</span><span class="text-text-muted">;</span>
          </div>
          <!-- SQL result table -->
          <div class="rounded-xl border border-border-color overflow-hidden shadow-xl">
            <div class="overflow-x-auto">
              <table class="w-full mono text-sm">
                <thead>
                  <tr class="border-b border-border-color bg-background/80">
                    <th class="text-left px-4 py-2.5 text-text-muted/50 font-normal text-xs">platform</th>
                    <th class="text-left px-4 py-2.5 text-text-muted/50 font-normal text-xs">url</th>
                    <th class="text-left px-4 py-2.5 text-text-muted/50 font-normal text-xs hidden md:table-cell">topics</th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="border-b border-border-color/20 hover:bg-background-alt/60 transition-colors">
                    <td class="px-4 py-3"><span class="sql-str">'medium'</span></td>
                    <td class="px-4 py-3">
                      <a
                        href="https://medium.com/@yujikawa"
                        target="_blank" rel="noopener noreferrer"
                        class="text-primary hover:text-secondary transition-colors"
                      >
                        medium.com/@yujikawa ↗
                      </a>
                    </td>
                    <td class="px-4 py-3 hidden md:table-cell text-text-muted/50 text-xs">
                      Analytics Engineering, dbt, data modeling
                    </td>
                  </tr>
                </tbody>
              </table>
            </div>
            <div class="px-4 py-2 border-t border-border-color/20 bg-background/50 mono text-xs text-text-muted/40">
              <span class="text-emerald-400">▶</span> 1 row returned
            </div>
          </div>
        </section>
      </AnimateOnScroll>

      <!-- ═══════════════════════════════════════════ -->
      <!-- PROJECTS: ER diagram entities               -->
      <!-- ═══════════════════════════════════════════ -->
      <AnimateOnScroll animation="slide-up" delay={0}>
        <section id="projects" class="py-12">
          <!-- SQL label -->
          <div class="mono text-xs text-text-muted/50 mb-3 flex flex-wrap gap-1 items-center">
            <span class="sql-kw">SELECT</span> *
            <span class="sql-kw">FROM</span>
            <span class="sql-tbl">projects</span>
            <span class="sql-kw">WHERE</span>
            <span class="sql-col">author</span>
            <span class="text-text-muted/60">=</span>
            <span class="sql-str">'yujikawa'</span><span class="text-text-muted">;</span>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            {featuredProjects.map((project, i) => (
              <a
                href={project.link}
                target="_blank" rel="noopener noreferrer"
                class="group block rounded-xl border border-border-color bg-background-alt/50 hover:border-primary/40 overflow-hidden transition-all duration-200 hover:-translate-y-0.5 hover:shadow-lg hover:shadow-primary/5"
              >
                <!-- ER table header -->
                <div class="flex items-center gap-2 px-4 py-2.5 border-b border-border-color bg-background/80 group-hover:border-primary/30 transition-colors">
                  <span class="text-primary text-xs">⬡</span>
                  <span class="mono text-sm font-bold text-text-base group-hover:text-primary transition-colors">
                    {project.slug}
                  </span>
                  <span class="ml-auto mono text-xs text-text-muted/30 group-hover:text-primary/50 transition-colors">↗</span>
                </div>
                <!-- Fields as ER columns -->
                <div class="p-4 mono text-xs space-y-1.5">
                  <div class="flex gap-3 items-center pb-1.5 border-b border-border-color/40">
                    <span class="text-amber-400/70 text-[10px] w-4">PK</span>
                    <span class="sql-col w-24 flex-shrink-0">id</span>
                    <span class="sql-num">{i + 1}</span>
                  </div>
                  <div class="flex gap-3 items-start pt-0.5">
                    <span class="w-4"></span>
                    <span class="sql-col w-24 flex-shrink-0">title</span>
                    <span class="sql-str">'{project.title}'</span>
                  </div>
                  <div class="flex gap-3 items-start">
                    <span class="w-4"></span>
                    <span class="sql-col w-24 flex-shrink-0">description</span>
                    <span class="text-text-muted/60 leading-relaxed">{project.description}</span>
                  </div>
                  <div class="flex gap-3 items-center pt-1">
                    <span class="w-4"></span>
                    <span class="sql-col w-24 flex-shrink-0">tags</span>
                    <div class="flex gap-1 flex-wrap">
                      {project.tags.map(tag => (
                        <span class="px-1.5 py-0.5 text-accent/70 bg-accent/10 border border-accent/20 rounded text-[10px]">
                          {tag}
                        </span>
                      ))}
                    </div>
                  </div>
                </div>
              </a>
            ))}
          </div>

          <!-- Row count footer -->
          <div class="mt-3 mono text-xs text-text-muted/40">
            <span class="text-emerald-400">▶</span> {featuredProjects.length} rows returned
          </div>
        </section>
      </AnimateOnScroll>

    </div>
  </main>
</Layout>
