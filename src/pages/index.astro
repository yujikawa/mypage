---
import Layout from '../layouts/Layout.astro';

const ghRes = await fetch('https://api.github.com/users/yujikawa').catch(() => null);
const ghUser = ghRes?.ok ? await ghRes.json() : null;
const ghStats = {
  repos:     ghUser?.public_repos ?? null,
  followers: ghUser?.followers    ?? null,
  following: ghUser?.following    ?? null,
};

const featuredProjects = [
  {
    title: "Modaryn",
    slug: "modaryn",
    description: "Analyzes dbt projects to score model complexity and structural importance.",
    link: "https://github.com/yujikawa/modaryn",
    tags: ["Python", "dbt", "CLI"],
  },
  {
    title: "Modscape",
    slug: "modscape",
    description: "A YAML-driven data modeling visualizer bridging conceptual and physical models.",
    link: "https://github.com/yujikawa/modscape",
    tags: ["TypeScript", "YAML", "Data Modeling"],
  },
];

const skills = ["dbt", "SQL", "Python", "BigQuery", "Snowflake", "Spark", "Airflow"];

const tabs = [
  { id: "skills",   file: "skills.sql"   },
  { id: "activity", file: "activity.sql" },
  { id: "writing",  file: "writing.sql"  },
  { id: "projects", file: "projects.sql" },
  { id: "salary",   file: "salary.sql"   },
];

const TABLE_META = [
  {
    id: 'fact_engineer',
    kind: 'fact' as const,
    description: 'The central fact table of this star schema. Represents me as a single engineer and holds foreign keys linking to all dimension tables.',
    columns: [
      { name: 'engineer_id', key: 'PK FK', desc: 'Unique identifier for the engineer. References dim_engineer.' },
      { name: 'skill_id',    key: 'FK',    desc: 'Current primary skill focus. References dim_skills.' },
      { name: 'project_id',  key: 'FK',    desc: 'Featured OSS project. References dim_projects.' },
      { name: 'writing_id',  key: 'FK',    desc: 'Writing platform record. References dim_writing.' },
      { name: 'activity_id', key: 'FK',    desc: 'GitHub activity snapshot. References dim_activity.' },
    ],
  },
  {
    id: 'dim_engineer',
    kind: 'dim' as const,
    description: 'Dimension holding personal attributes of the engineer — who I am. Name and role are stored here and used to filter queries.',
    columns: [
      { name: 'engineer_id', key: 'PK', desc: 'Unique identifier for the engineer.' },
      { name: 'name',        key: '',   desc: 'Engineer\'s name. Used in WHERE clauses to filter rows.' },
      { name: 'role',        key: '',   desc: 'Job title or role (e.g. Analytics Engineer).' },
    ],
  },
  {
    id: 'dim_skills',
    kind: 'dim' as const,
    description: 'Dimension for technical skills. Stores the skill set I use professionally — data modeling, SQL, Python and more — along with proficiency levels.',
    columns: [
      { name: 'id',          key: 'PK', desc: 'Unique identifier for the skill.' },
      { name: 'skill_name',  key: '',   desc: 'Name of the skill (e.g. dbt, SQL, Python).' },
      { name: 'category',    key: '',   desc: 'Skill category (e.g. Analytics Eng, Programming).' },
      { name: 'proficiency', key: '',   desc: 'Proficiency level (expert / proficient).' },
    ],
  },
  {
    id: 'dim_activity',
    kind: 'dim' as const,
    description: 'Dimension for GitHub contribution history. Captures daily coding habits and makes them queryable as time-series data.',
    columns: [
      { name: 'id',            key: 'PK', desc: 'Unique identifier for the activity record.' },
      { name: 'date',          key: '',   desc: 'Contribution date (DATE type).' },
      { name: 'contributions', key: '',   desc: 'Number of contributions on that day.' },
    ],
  },
  {
    id: 'dim_writing',
    kind: 'dim' as const,
    description: 'Dimension for writing platforms. Tracks where I publish articles — Medium, Qiita, Zenn — and the topics I write about.',
    columns: [
      { name: 'id',       key: 'PK', desc: 'Unique identifier for the platform record.' },
      { name: 'platform', key: '',   desc: 'Platform name (medium / qiita / zenn).' },
      { name: 'url',      key: '',   desc: 'Profile URL for the platform.' },
      { name: 'topics',   key: '',   desc: 'Main writing topics (e.g. Analytics Engineering, dbt).' },
    ],
  },
  {
    id: 'dim_projects',
    kind: 'dim' as const,
    description: 'Dimension for OSS projects. Holds metadata for tools I have built for the analytics engineering community.',
    columns: [
      { name: 'id',          key: 'PK', desc: 'Unique identifier for the project.' },
      { name: 'title',       key: '',   desc: 'Project name (e.g. Modaryn, Modscape).' },
      { name: 'description', key: '',   desc: 'Short description of what the project does.' },
      { name: 'tags',        key: '',   desc: 'Array of technology tags (TEXT[]).' },
      { name: 'github_url',  key: '',   desc: 'GitHub repository URL.' },
    ],
  },
];
---

<Layout title="mypage.sql">

<style>
  /* ── IDE window ── */
  .ide-window {
    display: flex;
    flex-direction: column;
    background: #0d1117;
    border: 1px solid #30363d;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 32px 80px rgba(0,0,0,0.7), 0 0 0 1px rgba(255,255,255,0.03);
  }

  /* ── Header ── */
  .ide-header {
    display: flex;
    align-items: center;
    gap: 0;
    padding: 0 12px;
    height: 42px;
    background: #161b22;
    border-bottom: 1px solid #21262d;
    flex-shrink: 0;
    user-select: none;
  }
  .header-brand {
    display: flex;
    align-items: center;
    gap: 7px;
    padding-right: 20px;
    border-right: 1px solid rgba(33,38,45,.8);
    margin-right: 4px;
    flex-shrink: 0;
  }
  .menu-item {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    color: rgba(139,148,158,.4);
    padding: 4px 10px;
    border-radius: 4px;
    cursor: default;
    transition: background .15s, color .15s;
    white-space: nowrap;
  }
  .menu-item:hover { background: rgba(255,255,255,.05); color: rgba(139,148,158,.75); }

  /* ── Editor + ER split ── */
  .ide-body {
    display: flex;
    flex: 1;
    overflow: hidden;
    min-height: 0;
  }

  /* ── Editor pane ── */
  .ide-editor-pane {
    display: flex;
    flex-direction: column;
    border-right: 1px solid #21262d;
    min-width: 0;
    width: 44%;
    flex-shrink: 0;
  }

  /* ── Tab bar ── */
  .ide-tabbar {
    display: flex;
    align-items: flex-end;
    background: #0d1117;
    border-bottom: 1px solid #21262d;
    overflow-x: auto;
    flex-shrink: 0;
    scrollbar-width: none;
  }
  .ide-tabbar::-webkit-scrollbar { display: none; }

  .ide-tab {
    display: flex;
    align-items: center;
    gap: 5px;
    padding: 6px 14px 7px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    color: rgba(139,148,158,.4);
    border-top: 1px solid transparent;
    border-right: 1px solid transparent;
    border-left: 1px solid transparent;
    cursor: pointer;
    white-space: nowrap;
    transition: color .15s, background .15s;
    background: transparent;
    position: relative;
    top: 1px;
    border-radius: 4px 4px 0 0;
  }
  .ide-tab:hover { color: rgba(139,148,158,.65); background: rgba(255,255,255,.03); }
  .ide-tab.active {
    color: #f0f0f0;
    background: #0d1117;
    border-color: #30363d;
    border-bottom-color: #0d1117;
  }
  .ide-tab.active .tab-dot { color: #3b82f6; }

  /* ── SQL Editor lines ── */
  .ide-editor-scroll {
    flex: 1;
    overflow-y: auto;
    background: #0d1117;
    scrollbar-width: thin;
    scrollbar-color: #30363d transparent;
  }
  .ide-editor-scroll::-webkit-scrollbar { width: 6px; }
  .ide-editor-scroll::-webkit-scrollbar-track { background: transparent; }
  .ide-editor-scroll::-webkit-scrollbar-thumb { background: #30363d; border-radius: 3px; }

  .ide-editor-content { display: none; padding-bottom: 16px; }
  .ide-editor-content.active { display: block; }

  .sql-line {
    display: flex;
    line-height: 1.7;
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
  }
  .sql-line:hover { background: rgba(255,255,255,.025); }
  .sql-line.highlighted { background: rgba(59,130,246,.06); }

  .ln {
    width: 44px;
    text-align: right;
    padding-right: 16px;
    color: rgba(139,148,158,.22);
    flex-shrink: 0;
    user-select: none;
  }
  .lc { padding-right: 16px; color: rgba(240,240,240,.85); flex: 1; }

  /* blinking cursor */
  .sql-cursor {
    display: inline-block;
    width: 2px;
    height: 14px;
    background: #3b82f6;
    vertical-align: text-bottom;
    animation: blink 1.1s step-end infinite;
    border-radius: 1px;
  }
  @keyframes blink { 50% { opacity: 0; } }

  /* ── Editor footer ── */
  .ide-editor-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 5px 10px;
    background: #161b22;
    border-top: 1px solid #21262d;
    flex-shrink: 0;
  }

  /* ── Run button ── */
  .run-btn {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 4px 12px;
    background: rgba(59,130,246,.15);
    border: 1px solid rgba(59,130,246,.3);
    border-radius: 5px;
    color: rgba(59,130,246,.85);
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    cursor: pointer;
    transition: background .15s, transform .1s;
  }
  .run-btn:hover { background: rgba(59,130,246,.25); }
  .run-btn:active { transform: scale(.96); }
  .run-btn.running { opacity: .6; pointer-events: none; }

  /* ── Language toggle ── */
  .lang-btn {
    padding: 2px 7px;
    background: transparent;
    border: 1px solid rgba(48,54,61,.8);
    border-radius: 3px;
    color: rgba(139,148,158,.35);
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px;
    cursor: pointer;
    transition: color .15s, border-color .15s;
  }
  .lang-btn:hover { color: rgba(139,148,158,.7); border-color: rgba(139,148,158,.3); }
  .lang-btn.active { color: rgba(59,130,246,.85); border-color: rgba(59,130,246,.4); background: rgba(59,130,246,.08); }

  /* ── ER pane ── */
  .ide-er-pane {
    display: flex;
    flex-direction: column;
    flex: 1;
    min-width: 0;
    background: #090d12;
  }
  .ide-panel-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 5px 12px;
    background: #0d1117;
    border-bottom: 1px solid #21262d;
    flex-shrink: 0;
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px;
    color: rgba(139,148,158,.4);
  }
  .ide-er-scroll {
    flex: 1;
    overflow: auto;
    position: relative;
    background-image: radial-gradient(circle, #1e2530 1px, transparent 1px);
    background-size: 20px 20px;
    scrollbar-width: thin;
    scrollbar-color: #30363d transparent;
  }

  /* ── View toggle ── */
  .view-toggle {
    display: flex;
    gap: 2px;
    background: rgba(0,0,0,.3);
    border: 1px solid rgba(255,255,255,.06);
    border-radius: 5px;
    padding: 2px;
  }
  .view-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 20px;
    border-radius: 3px;
    cursor: pointer;
    color: rgba(139,148,158,.35);
    transition: background .12s, color .12s;
    border: none;
    background: transparent;
  }
  .view-btn:hover { color: rgba(139,148,158,.7); }
  .view-btn.active { background: rgba(59,130,246,.2); color: rgba(59,130,246,.85); }

  .result-view { display: none; }
  .result-view.active { display: block; }
  .result-view-card.active { display: flex; }

  /* ── Panel divider (cosmetic resize handle) ── */
  .ide-divider {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 4px 12px;
    background: #161b22;
    border-top: 1px solid #21262d;
    border-bottom: 1px solid #21262d;
    flex-shrink: 0;
    cursor: row-resize;
    user-select: none;
  }
  .divider-dots { display: flex; gap: 2px; }
  .divider-dot { width: 14px; height: 2px; background: rgba(139,148,158,.12); border-radius: 1px; }

  /* ── Results pane ── */
  .ide-results-pane {
    display: flex;
    flex-direction: column;
    background: #0d1117;
    flex-shrink: 0;
    height: 34%;
    min-height: 160px;
    max-height: 48%;
  }

  .ide-result-content { display: none; }
  .ide-result-content.visible {
    display: block;
    animation: resultIn .4s ease forwards;
  }
  @keyframes resultIn {
    from { opacity: 0; transform: translateY(8px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  .result-table { width: 100%; border-collapse: collapse; }
  .result-table th {
    text-align: left;
    padding: 7px 14px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px;
    font-weight: normal;
    color: rgba(139,148,158,.5);
    background: #161b22;
    border-bottom: 1px solid #21262d;
    position: sticky;
    top: 0;
    z-index: 1;
  }
  .result-table td {
    padding: 6px 14px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    border-bottom: 1px solid rgba(33,38,45,.5);
    transition: background .1s;
  }
  .result-table tr:hover td { background: rgba(255,255,255,.02); }
  .row-num { color: rgba(139,148,158,.2); width: 36px; }

  /* ── Status bar ── */
  .ide-statusbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 4px 12px;
    background: rgba(59,130,246,.12);
    border-top: 1px solid rgba(59,130,246,.2);
    flex-shrink: 0;
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px;
  }

  /* ── Empty state ── */
  .results-empty {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100%;
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    color: rgba(139,148,158,.2);
  }

  /* ── Explorer pane (leftmost) ── */
  .ide-explorer-pane {
    display: flex;
    flex-direction: column;
    width: 168px;
    flex-shrink: 0;
    border-right: 1px solid #21262d;
    background: #0d1117;
    overflow: hidden;
  }
  .ide-explorer-scroll {
    flex: 1;
    overflow-y: auto;
    scrollbar-width: thin;
    scrollbar-color: #30363d transparent;
  }
  .explorer-section {
    padding: 6px 0 2px;
  }
  .explorer-section-label {
    display: flex;
    align-items: center;
    gap: 4px;
    padding: 3px 10px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 9px;
    color: rgba(139,148,158,.3);
    text-transform: uppercase;
    letter-spacing: .06em;
    user-select: none;
  }
  .explorer-item {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 4px 10px 4px 18px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px;
    color: rgba(139,148,158,.5);
    cursor: pointer;
    transition: background .12s, color .12s;
    border-left: 2px solid transparent;
  }
  .explorer-item:hover { background: rgba(255,255,255,.04); color: rgba(139,148,158,.8); }
  .explorer-item.active {
    color: #9cdcfe;
    background: rgba(59,130,246,.08);
    border-left-color: #3b82f6;
  }
  .explorer-item.fact {
    color: rgba(86,156,214,.7);
    cursor: default;
    border-left: 2px solid rgba(59,130,246,.3);
    background: rgba(59,130,246,.04);
  }
  .explorer-item .ei-icon { font-size: 8px; flex-shrink: 0; }

  /* ── Profile popup ── */
  .profile-popup {
    position: absolute;
    top: calc(100% + 6px);
    right: 0;
    width: 200px;
    border-radius: 8px;
    border: 1px solid #30363d;
    background: #161b22;
    overflow: hidden;
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px;
    z-index: 100;
    box-shadow: 0 12px 40px rgba(0,0,0,.7), 0 0 0 1px rgba(255,255,255,.04);
    opacity: 0;
    transform: translateY(-4px) scale(.98);
    pointer-events: none;
    transition: opacity .18s ease, transform .18s ease;
  }
  .profile-popup.open {
    opacity: 1;
    transform: translateY(0) scale(1);
    pointer-events: auto;
  }
  .profile-trigger {
    position: relative;
    display: flex;
    align-items: center;
    gap: 6px;
    cursor: pointer;
    padding: 2px 4px;
    border-radius: 5px;
    transition: background .15s;
  }
  .profile-trigger:hover { background: rgba(255,255,255,.06); }

  /* ── Mobile layout ── */
  @media (max-width: 767px) {
    /* IDE window: auto height (scroll instead of fixed viewport) */
    .ide-window { height: auto !important; min-height: unset !important; }

    /* Body: vertical stack */
    .ide-body {
      flex-direction: column;
      overflow: visible;
      min-height: 0;
    }

    /* Hide explorer */
    .ide-explorer-pane { display: none; }

    /* ER diagram: top, fixed height */
    .ide-er-pane {
      order: 1;
      width: 100%;
      height: 300px;
      flex-shrink: 0;
      border-right: none;
      border-bottom: 1px solid #21262d;
    }

    /* SQL editor: middle */
    .ide-editor-pane {
      order: 2;
      width: 100%;
      height: auto;
      min-height: 160px;
      flex-shrink: 0;
      border-right: none;
      border-bottom: 1px solid #21262d;
    }
    .ide-editor-scroll { max-height: 200px; }

    /* Results: bottom, auto height */
    .ide-results-pane {
      order: 3;
      height: auto;
      max-height: none;
      min-height: 200px;
      flex-shrink: 0;
    }

    /* Menu bar: hide less important items */
    .menu-item:nth-child(n+4) { display: none; }
  }
</style>

<main class="px-3 sm:px-4 pb-4 pt-4">

  <div class="ide-window" id="ide-window" style="height: calc(100vh - 2rem); min-height: 580px;">

    <!-- ── Header ── -->
    <div class="ide-header">
      <!-- Brand -->
      <div class="header-brand">
        <svg viewBox="0 0 16 16" style="width:14px;height:14px;fill:rgba(59,130,246,.6);flex-shrink:0;">
          <path d="M2 2.5A2.5 2.5 0 014.5 0h8.75a.75.75 0 01.75.75v12.5a.75.75 0 01-.75.75h-2.5a.75.75 0 110-1.5h1.75v-2h-8a1 1 0 00-.714 1.7.75.75 0 01-1.072 1.05A2.495 2.495 0 012 11.5v-9zm10.5-1V9h-8c-.356 0-.694.074-1 .208V2.5a1 1 0 011-1h8z"/>
        </svg>
        <span class="mono" style="font-size:12px;color:rgba(240,240,240,.6);font-weight:500;">My page</span>
      </div>
      <!-- Menu items -->
      {["File", "Edit", "View", "Run", "Help"].map(item => (
        <button class="menu-item">{item}</button>
      ))}
      <!-- Spacer -->
      <div style="flex:1;"></div>
      <!-- Language toggle -->
      <div style="display:flex;align-items:center;gap:3px;margin-right:12px;">
        <button class="lang-btn active" id="lang-en" data-lang="en">EN</button>
        <button class="lang-btn"        id="lang-ja" data-lang="ja">JA</button>
      </div>
      <!-- Online badge -->
      <div style="display:flex;align-items:center;gap:5px;margin-right:14px;padding-right:14px;border-right:1px solid rgba(33,38,45,.8);">
        <span style="width:5px;height:5px;border-radius:50%;background:#34d399;display:inline-block;flex-shrink:0;"></span>
        <span class="mono" style="font-size:10px;color:rgba(139,148,158,.3);" data-i18n="role-badge">Analytics Engineer</span>
      </div>
      <!-- Profile trigger -->
      <div style="position:relative;">
        <div class="profile-trigger" id="profile-trigger">
          <img src="/mypage/icon.png" alt="Yuji" style="width:22px;height:22px;border-radius:50%;border:1px solid rgba(59,130,246,.25);object-fit:cover;" />
          <span class="mono" style="font-size:11px;color:rgba(139,148,158,.5);">Yuji</span>
          <svg viewBox="0 0 10 6" style="width:8px;height:8px;fill:none;stroke:rgba(139,148,158,.3);stroke-width:1.5;flex-shrink:0;"><path d="M1 1l4 4 4-4"/></svg>
        </div>
        <!-- Profile popup -->
        <div class="profile-popup" id="profile-popup">
          <div style="padding:7px 10px;border-bottom:1px solid rgba(33,38,45,.7);display:flex;align-items:center;gap:6px;">
            <span style="width:6px;height:6px;border-radius:50%;background:#34d399;display:inline-block;flex-shrink:0;"></span>
            <span style="color:rgba(52,211,153,.7);">active</span>
            <span style="margin-left:auto;color:rgba(139,148,158,.25);">engineers · id:1</span>
          </div>
          <div style="padding:10px;display:flex;align-items:center;gap:9px;border-bottom:1px solid rgba(33,38,45,.5);">
            <div style="position:relative;flex-shrink:0;">
              <img src="/mypage/icon.png" alt="Yuji" style="width:36px;height:36px;border-radius:50%;border:1px solid rgba(59,130,246,.25);object-fit:cover;" />
              <div style="position:absolute;bottom:0;right:0;width:9px;height:9px;border-radius:50%;background:#34d399;border:1.5px solid #161b22;"></div>
            </div>
            <div>
              <div style="color:#f0f0f0;font-weight:700;font-size:12px;">Yuji</div>
              <div style="color:rgba(139,148,158,.4);font-size:9px;margin-top:1px;">Analytics Engineer</div>
              <div style="color:rgba(139,148,158,.3);font-size:9px;">Japan</div>
            </div>
          </div>
          <div style="padding:8px 10px;border-bottom:1px solid rgba(33,38,45,.5);">
            {[
              { col: "name",     val: "'Yuji'",             },
              { col: "role",     val: "'Analytics Eng'",   },
              { col: "location", val: "'Japan'",           },
              { col: "passion",  val: "'biz users + data'" },
            ].map(({ col, val }) => (
