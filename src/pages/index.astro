---
import Layout from '../layouts/Layout.astro';
import AnimateOnScroll from '../components/AnimateOnScroll.astro';

const featuredProjects = [
  {
    title: "Modaryn",
    slug: "modaryn",
    description: "Analyzes dbt projects to score model complexity and structural importance.",
    link: "https://github.com/yujikawa/modaryn",
    tags: ["Python", "dbt", "CLI"],
  },
  {
    title: "Modscape",
    slug: "modscape",
    description: "A YAML-driven data modeling visualizer bridging conceptual and physical models.",
    link: "https://github.com/yujikawa/modscape",
    tags: ["TypeScript", "YAML", "Data Modeling"],
  },
];

const skills = ["dbt", "SQL", "Python", "BigQuery", "Snowflake", "Spark", "Airflow"];
---

<Layout title="Welcome">
  <main class="min-h-screen pt-24 pb-20">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">

      <!-- ═══════════════════════════════════════════ -->
      <!-- STAR SCHEMA                                 -->
      <!-- ═══════════════════════════════════════════ -->
      <AnimateOnScroll animation="slide-up" delay={0}>
        <section class="py-12">
          <!-- ── Miro-style canvas ── -->
          <div class="rounded-xl border border-border-color overflow-hidden shadow-2xl shadow-black/40">

            <!-- Toolbar -->
            <div class="flex items-center gap-1 px-3 py-2 border-b border-border-color bg-[#161b22]">
              <!-- App icon + board name -->
              <div class="flex items-center gap-2 mr-3">
                <div class="h-5 w-5 rounded bg-primary/80 flex items-center justify-center flex-shrink-0">
                  <svg viewBox="0 0 16 16" class="h-3 w-3 fill-white" xmlns="http://www.w3.org/2000/svg">
                    <rect x="2" y="2" width="5" height="5" rx="1"/><rect x="9" y="2" width="5" height="5" rx="1"/>
                    <rect x="2" y="9" width="5" height="5" rx="1"/><rect x="9" y="9" width="5" height="5" rx="1"/>
                  </svg>
                </div>
                <span class="mono text-xs text-text-muted/60">data_model.board</span>
              </div>
              <!-- Divider -->
              <div class="h-4 w-px bg-border-color/50 mx-1"></div>
              <!-- Tool buttons (cosmetic) -->
              {["↖", "✥", "◻", "🔗"].map(icon => (
                <button class="h-6 w-6 rounded flex items-center justify-center text-[11px] text-text-muted/30 hover:bg-background-alt hover:text-text-muted/60 transition-colors">{icon}</button>
              ))}
              <!-- Spacer -->
              <div class="flex-1"></div>
              <!-- Zoom + status -->
              <span class="mono text-[10px] text-text-muted/30 px-2 py-1 rounded border border-border-color/30 bg-background/40">75%</span>
              <button class="mono text-[10px] text-text-muted/30 px-2 py-1 rounded border border-border-color/30 bg-background/40 hover:text-text-muted/60 transition-colors ml-1">Fit</button>
              <div class="h-4 w-px bg-border-color/50 mx-2"></div>
              <span class="mono text-[10px] text-text-muted/25 hidden sm:inline">hover · click to navigate</span>
            </div>

            <!-- Canvas area -->
            <div class="relative overflow-x-auto" style="background-color:#090d12;background-image:radial-gradient(circle,#30363d 1px,transparent 1px);background-size:24px 24px;min-height:520px;">

              <!-- Text object (top-left) -->
              <div class="absolute top-6 left-5 select-none pointer-events-none">
                <div class="text-2xl font-bold text-text-base/80 leading-tight" style="font-family:'Syne',sans-serif;">Yuji's Portfolio</div>
                <div class="mono text-[11px] text-text-muted/35 mt-1">Analytics Engineer · Data Modeling</div>
              </div>

              <!-- Author / profile card -->
              <div class="absolute top-6 right-4 w-52 rounded-lg border border-border-color/60 bg-[#161b22]/95 shadow-xl backdrop-blur-sm overflow-hidden mono text-[10px]">
                <!-- header: active status -->
                <div class="px-3 py-2 border-b border-border-color/40 flex items-center gap-1.5">
                  <span class="h-1.5 w-1.5 rounded-full bg-emerald-400 animate-pulse shadow shadow-emerald-400/60"></span>
                  <span class="text-emerald-400/70">active</span>
                  <span class="ml-auto text-text-muted/25">engineers · id:1</span>
                </div>
                <!-- avatar + name -->
                <div class="px-3 py-3 flex items-center gap-3 border-b border-border-color/30">
                  <div class="relative flex-shrink-0">
                    <div class="absolute inset-0 rounded-full animate-glow"></div>
                    <img src="/mypage/icon.png" alt="Yuji" class="relative h-10 w-10 rounded-full border border-primary/25 object-cover" />
                    <div class="absolute bottom-0 right-0 h-2.5 w-2.5 rounded-full bg-emerald-400 border-2 border-[#161b22] shadow shadow-emerald-400/40"></div>
                  </div>
                  <div>
                    <div class="text-text-base font-bold text-[11px]">Yuji</div>
                    <div class="text-text-muted/40">Analytics Engineer</div>
                  </div>
                </div>
                <!-- fields -->
                <div class="px-3 py-2.5 space-y-1.5 border-b border-border-color/30">
                  {[
                    { col: "name",     val: "'Yuji'",                 type: "str" },
                    { col: "role",     val: "'Analytics Engineer'",   type: "str" },
                    { col: "location", val: "'Japan'",                type: "str" },
                    { col: "stack",    val: "ARRAY[...]",             type: "kw"  },
                    { col: "passion",  val: "'working with biz users'", type: "str" },
                  ].map(({ col, val, type }) => (
                    <div class="flex items-start gap-2">
                      <span class="sql-col w-14 flex-shrink-0">{col}</span>
                      <span class="text-border-color/50">│</span>
                      <span class={
                        type === "str" ? "sql-str truncate" :
                        type === "kw"  ? "sql-kw"  :
                        "text-emerald-400"
                      }>{val}</span>
                    </div>
                  ))}
                </div>
                <!-- skills/stack -->
                <div class="px-3 py-2.5 border-b border-border-color/30 flex flex-wrap gap-1">
                  {skills.map(skill => (
                    <span class="px-1.5 py-0.5 text-accent/60 bg-accent/8 border border-accent/20 rounded text-[9px]">{skill}</span>
                  ))}
                </div>
                <!-- links -->
                <div class="px-3 py-2 flex gap-1.5">
                  <a href="https://github.com/yujikawa" target="_blank" rel="noopener noreferrer"
                    class="flex-1 flex items-center justify-center gap-1 py-1.5 rounded border border-border-color/40 text-text-muted/40 hover:text-text-muted/70 hover:border-border-color/70 transition-colors">
                    <svg viewBox="0 0 16 16" class="h-2.5 w-2.5" fill="currentColor"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38C13.71 14.53 16 11.54 16 8c0-4.42-3.58-8-8-8z"/></svg>
                    GitHub
                  </a>
                  <a href="https://medium.com/@yujikawa" target="_blank" rel="noopener noreferrer"
                    class="flex-1 flex items-center justify-center gap-1 py-1.5 rounded border border-border-color/40 text-text-muted/40 hover:text-text-muted/70 hover:border-border-color/70 transition-colors">
                    <svg viewBox="0 0 24 24" class="h-2.5 w-2.5" fill="currentColor"><path d="M13.54 12a6.8 6.8 0 01-6.77 6.82A6.8 6.8 0 010 12a6.8 6.8 0 016.77-6.82A6.8 6.8 0 0113.54 12zM20.96 12c0 3.54-1.51 6.42-3.38 6.42-1.87 0-3.39-2.88-3.39-6.42s1.52-6.42 3.39-6.42 3.38 2.88 3.38 6.42M24 12c0 3.17-.53 5.75-1.19 5.75-.66 0-1.19-2.58-1.19-5.75s.53-5.75 1.19-5.75C23.47 6.25 24 8.83 24 12z"/></svg>
                    Medium
                  </a>
                </div>
              </div>

              <!-- ER Diagram SVG (centered on canvas) -->
              <div class="px-4 py-10 pr-52 overflow-x-auto">
                <svg id="schema-svg" viewBox="0 0 800 460" class="w-full max-w-3xl mx-auto min-w-[480px]" xmlns="http://www.w3.org/2000/svg">

                <!-- Relationship lines (initially hidden, animated in) -->
                <line id="line-skills"   x1="400" y1="168" x2="400" y2="110" stroke="#30363d" stroke-width="1.5"/>
                <line id="line-activity" x1="400" y1="310" x2="400" y2="350" stroke="#30363d" stroke-width="1.5"/>
                <line id="line-projects" x1="270" y1="239" x2="230" y2="239" stroke="#30363d" stroke-width="1.5"/>
                <line id="line-writing"  x1="530" y1="239" x2="570" y2="239" stroke="#30363d" stroke-width="1.5"/>

                <!-- 1:N labels -->
                <text id="lbl-skills"   x="406" y="143" fill="#8b949e" font-size="9" font-family="JetBrains Mono, monospace" opacity="0">1:N</text>
                <text id="lbl-activity" x="406" y="334" fill="#8b949e" font-size="9" font-family="JetBrains Mono, monospace" opacity="0">1:N</text>
                <text id="lbl-projects" x="240" y="233" fill="#8b949e" font-size="9" font-family="JetBrains Mono, monospace" opacity="0">1:N</text>
                <text id="lbl-writing"  x="538" y="233" fill="#8b949e" font-size="9" font-family="JetBrains Mono, monospace" opacity="0">1:N</text>

                <!-- dim_skills (top) — click → skills section -->
                <g id="dim-skills" style="cursor:pointer">
                  <rect id="rect-skills" x="300" y="20" width="200" height="90" rx="5" fill="#161b22" stroke="#30363d" stroke-width="1"/>
                  <line x1="300" y1="44" x2="500" y2="44" stroke="#30363d" stroke-width="1"/>
                  <text x="314" y="36" fill="#4ec9b0" font-size="11" font-weight="600" font-family="JetBrains Mono, monospace">⬡ dim_skills</text>
                  <text x="314" y="60" fill="#9cdcfe" font-size="10" font-family="JetBrains Mono, monospace">skill_name    TEXT</text>
                  <text x="314" y="75" fill="#8b949e" font-size="9"  font-family="JetBrains Mono, monospace">               -- 'dbt','SQL','Python'</text>
                  <text x="314" y="90" fill="#9cdcfe" font-size="10" font-family="JetBrains Mono, monospace">category      TEXT</text>
                </g>

                <!-- dim_projects (left) — click → projects section -->
                <g id="dim-projects" style="cursor:pointer">
                  <rect id="rect-projects" x="30" y="194" width="200" height="90" rx="5" fill="#161b22" stroke="#30363d" stroke-width="1"/>
                  <line x1="30" y1="218" x2="230" y2="218" stroke="#30363d" stroke-width="1"/>
                  <text x="44" y="210" fill="#4ec9b0" font-size="11" font-weight="600" font-family="JetBrains Mono, monospace">⬡ dim_projects</text>
                  <text x="44" y="234" fill="#9cdcfe" font-size="10" font-family="JetBrains Mono, monospace">title         TEXT</text>
                  <text x="44" y="249" fill="#8b949e" font-size="9"  font-family="JetBrains Mono, monospace">               -- 'modaryn','modscape'</text>
                  <text x="44" y="264" fill="#9cdcfe" font-size="10" font-family="JetBrains Mono, monospace">tags          TEXT[]</text>
                </g>

                <!-- dim_writing (right) — click → writing section -->
                <g id="dim-writing" style="cursor:pointer">
                  <rect id="rect-writing" x="570" y="194" width="200" height="90" rx="5" fill="#161b22" stroke="#30363d" stroke-width="1"/>
                  <line x1="570" y1="218" x2="770" y2="218" stroke="#30363d" stroke-width="1"/>
                  <text x="584" y="210" fill="#4ec9b0" font-size="11" font-weight="600" font-family="JetBrains Mono, monospace">⬡ dim_writing</text>
                  <text x="584" y="234" fill="#9cdcfe" font-size="10" font-family="JetBrains Mono, monospace">platform      TEXT</text>
                  <text x="584" y="249" fill="#8b949e" font-size="9"  font-family="JetBrains Mono, monospace">               -- 'medium','qiita','zenn'</text>
                  <text x="584" y="264" fill="#9cdcfe" font-size="10" font-family="JetBrains Mono, monospace">url           TEXT</text>
                </g>

                <!-- dim_activity (bottom) — click → activity section -->
                <g id="dim-activity" style="cursor:pointer">
                  <rect id="rect-activity" x="300" y="350" width="200" height="90" rx="5" fill="#161b22" stroke="#30363d" stroke-width="1"/>
                  <line x1="300" y1="374" x2="500" y2="374" stroke="#30363d" stroke-width="1"/>
                  <text x="314" y="366" fill="#4ec9b0" font-size="11" font-weight="600" font-family="JetBrains Mono, monospace">⬡ dim_activity</text>
                  <text x="314" y="390" fill="#9cdcfe" font-size="10" font-family="JetBrains Mono, monospace">date          DATE</text>
                  <text x="314" y="405" fill="#9cdcfe" font-size="10" font-family="JetBrains Mono, monospace">contributions INT</text>
                  <text x="314" y="420" fill="#8b949e" font-size="9"  font-family="JetBrains Mono, monospace">               -- github activity</text>
                </g>

                <!-- fact_engineer (center) -->
                <rect x="270" y="168" width="260" height="142" rx="6" fill="#0d1117" stroke="#3b82f6" stroke-width="1.5"/>
                <line x1="270" y1="194" x2="530" y2="194" stroke="#3b82f6" stroke-width="1" opacity="0.5"/>
                <text x="286" y="185" fill="#569cd6" font-size="12" font-weight="700" font-family="JetBrains Mono, monospace">⬡ fact_engineer</text>

                <text x="286" y="212" fill="#f59e0b" font-size="9"  font-family="JetBrains Mono, monospace">PK</text>
                <text x="308" y="212" fill="#9cdcfe" font-size="10" font-family="JetBrains Mono, monospace">engineer_id</text>
                <text x="430" y="212" fill="#8b949e" font-size="9"  font-family="JetBrains Mono, monospace">INT  -- 1</text>
                <line x1="286" y1="218" x2="514" y2="218" stroke="#30363d" stroke-width="0.5"/>

                <g id="fk-skills">
                  <text x="286" y="234" fill="#6a9955" font-size="9"  font-family="JetBrains Mono, monospace">FK</text>
                  <text x="308" y="234" fill="#9cdcfe" font-size="10" font-family="JetBrains Mono, monospace">skill_id</text>
                  <text x="430" y="234" fill="#8b949e" font-size="9"  font-family="JetBrains Mono, monospace">INT</text>
                </g>
                <g id="fk-projects">
                  <text x="286" y="252" fill="#6a9955" font-size="9"  font-family="JetBrains Mono, monospace">FK</text>
                  <text x="308" y="252" fill="#9cdcfe" font-size="10" font-family="JetBrains Mono, monospace">project_id</text>
                  <text x="430" y="252" fill="#8b949e" font-size="9"  font-family="JetBrains Mono, monospace">INT</text>
                </g>
                <g id="fk-writing">
                  <text x="286" y="270" fill="#6a9955" font-size="9"  font-family="JetBrains Mono, monospace">FK</text>
                  <text x="308" y="270" fill="#9cdcfe" font-size="10" font-family="JetBrains Mono, monospace">writing_id</text>
                  <text x="430" y="270" fill="#8b949e" font-size="9"  font-family="JetBrains Mono, monospace">INT</text>
                </g>
                <g id="fk-activity">
                  <text x="286" y="288" fill="#6a9955" font-size="9"  font-family="JetBrains Mono, monospace">FK</text>
                  <text x="308" y="288" fill="#9cdcfe" font-size="10" font-family="JetBrains Mono, monospace">activity_id</text>
                  <text x="430" y="288" fill="#8b949e" font-size="9"  font-family="JetBrains Mono, monospace">INT</text>
                </g>
              </svg>
              </div><!-- /SVG wrapper -->
            </div><!-- /canvas area -->
          </div><!-- /miro container -->
        </section>
      </AnimateOnScroll>

      <script>
        // ── Line lengths (precomputed from SVG coordinates) ──
        const lineLengths: Record<string, number> = {
          'line-skills':   58, // sqrt((400-400)²+(168-110)²)
          'line-activity': 40, // sqrt((400-400)²+(310-350)²)
          'line-projects': 40, // sqrt((270-230)²+(239-239)²)
          'line-writing':  40, // sqrt((530-570)²+(239-239)²)
        };

        // Init: hide all lines
        Object.entries(lineLengths).forEach(([id, len]) => {
          const el = document.getElementById(id);
          if (el) {
            el.setAttribute('stroke-dasharray', String(len));
            el.setAttribute('stroke-dashoffset', String(len));
          }
        });

        // Animate lines when schema enters viewport
        const svg = document.getElementById('schema-svg');
        let drawn = false;
        if (svg) {
          new IntersectionObserver(([entry]) => {
            if (!entry.isIntersecting || drawn) return;
            drawn = true;
            const lineOrder = ['line-skills', 'line-projects', 'line-writing', 'line-activity'];
            const lblOrder  = ['lbl-skills',  'lbl-projects',  'lbl-writing',  'lbl-activity'];
            lineOrder.forEach((id, i) => {
              setTimeout(() => {
                const line = document.getElementById(id) as SVGLineElement | null;
                const lbl  = document.getElementById(lblOrder[i]);
                if (line) {
                  line.style.transition = 'stroke-dashoffset 0.5s cubic-bezier(0.4,0,0.2,1)';
                  line.style.strokeDashoffset = '0';
                }
                if (lbl) {
                  lbl.style.transition = 'opacity 0.3s ease';
                  lbl.setAttribute('opacity', '1');
                }
              }, i * 130);
            });
          }, { threshold: 0.3 }).observe(svg);
        }

        // ── Hover highlight + click to scroll ──
        const BLUE = '#3b82f6';
        const interactions = [
          { dim: 'dim-skills',   rect: 'rect-skills',   line: 'line-skills',   lbl: 'lbl-skills',   fk: 'fk-skills',   section: 'skills'   },
          { dim: 'dim-projects', rect: 'rect-projects', line: 'line-projects', lbl: 'lbl-projects', fk: 'fk-projects', section: 'projects' },
          { dim: 'dim-writing',  rect: 'rect-writing',  line: 'line-writing',  lbl: 'lbl-writing',  fk: 'fk-writing',  section: 'writing'  },
          { dim: 'dim-activity', rect: 'rect-activity', line: 'line-activity', lbl: 'lbl-activity', fk: 'fk-activity', section: 'activity' },
        ];

        interactions.forEach(({ dim, rect, line, lbl, fk, section }) => {
          const dimEl  = document.getElementById(dim);
          const rectEl = document.getElementById(rect);
          const lineEl = document.getElementById(line);
          const lblEl  = document.getElementById(lbl);
          const fkEl   = document.getElementById(fk);
          if (!dimEl) return;

          dimEl.addEventListener('mouseenter', () => {
            rectEl?.setAttribute('stroke', BLUE);
            lineEl?.setAttribute('stroke', BLUE);
            lblEl?.setAttribute('fill', BLUE);
            fkEl?.querySelectorAll('text').forEach(t => t.setAttribute('fill', BLUE));
          });

          dimEl.addEventListener('mouseleave', () => {
            rectEl?.setAttribute('stroke', '#30363d');
            lineEl?.setAttribute('stroke', '#30363d');
            lblEl?.setAttribute('fill', '#8b949e');
            fkEl?.querySelectorAll('text').forEach((t, i) => {
              t.setAttribute('fill', i === 0 ? '#6a9955' : i === 1 ? '#9cdcfe' : '#8b949e');
            });
          });

          if (section) {
            dimEl.addEventListener('click', () => {
              document.getElementById(section)?.scrollIntoView({ behavior: 'smooth' });
            });
          }
        });
      </script>

      <!-- ═══════════════════════════════════════════ -->
      <!-- SKILLS                                      -->
      <!-- ═══════════════════════════════════════════ -->
      <AnimateOnScroll animation="slide-up" delay={0}>
        <section id="skills" class="py-12">
          <div class="mono text-xs mb-0 rounded-lg border border-dashed border-border-color/60 bg-background-alt/30 px-4 py-3 flex gap-3">
            <span class="text-teal-400/70 flex-shrink-0 select-none">analytics=#</span>
            <div class="leading-6 text-text-muted/60">
              <div><span class="sql-cmt">-- passion: 'working with business users on data requirements'</span></div>
              <div><span class="sql-kw">SELECT</span> <span class="sql-col">s.skill_name</span><span class="text-text-muted">,</span> <span class="sql-col">s.category</span><span class="text-text-muted">,</span> <span class="sql-col">s.proficiency</span></div>
              <div><span class="sql-kw">FROM</span>      <span class="sql-tbl">fact_engineer</span> <span class="sql-col">f</span></div>
              <div><span class="sql-kw">LEFT JOIN</span> <span class="sql-tbl">dim_skills</span> <span class="sql-col">s</span> <span class="sql-kw">ON</span> <span class="sql-col">f.skill_id</span> <span class="text-text-muted/60">=</span> <span class="sql-col">s.id</span></div>
              <div><span class="sql-kw">WHERE</span>     <span class="sql-col">f.engineer_id</span> <span class="text-text-muted/60">=</span> <span class="sql-num">1</span><span class="text-text-muted">;</span></div>
            </div>
          </div>
          <div class="sql-connector flex items-center gap-2 my-2 mono text-[10px] pl-2" data-rows="5 rows returned">
            <span>▼</span>
            <span>executing...</span>
          </div>
          <div class="rounded-xl border border-border-color overflow-hidden shadow-xl">
            <div class="overflow-x-auto">
              <table class="w-full mono text-sm">
                <thead>
                  <tr class="border-b border-border-color bg-background/80">
                    <th class="text-left px-4 py-2.5 text-text-muted/50 font-normal text-xs">skill_name</th>
                    <th class="text-left px-4 py-2.5 text-text-muted/50 font-normal text-xs hidden sm:table-cell">category</th>
                    <th class="text-left px-4 py-2.5 text-text-muted/50 font-normal text-xs hidden md:table-cell">proficiency</th>
                  </tr>
                </thead>
                <tbody>
                  {[
                    { name: "Data Modeling",     category: "Analytics Engineering", level: "expert",     passion: true  },
                    { name: "Data Engineering",  category: "Engineering",           level: "proficient", passion: false },
                    { name: "SQL",               category: "Query Language",        level: "expert",     passion: false },
                    { name: "Python",            category: "Programming",           level: "proficient", passion: false },
                    { name: "Airflow",           category: "Orchestration",         level: "proficient", passion: false },
                  ].map(skill => (
                    <tr class="border-b border-border-color/20 hover:bg-background-alt/60 transition-colors">
                      <td class="px-4 py-3 flex items-center gap-2">
                        <span class="sql-str">'{skill.name}'</span>
                        {skill.passion && (
                          <span class="text-[10px] px-1.5 py-0.5 rounded border border-accent/30 text-accent/70 bg-accent/5 hidden lg:inline">★ passion</span>
