---
import Layout from '../layouts/Layout.astro';

const ghRes = await fetch('https://api.github.com/users/yujikawa').catch(() => null);
const ghUser = ghRes?.ok ? await ghRes.json() : null;
const ghStats = {
  repos:     ghUser?.public_repos ?? null,
  followers: ghUser?.followers    ?? null,
  following: ghUser?.following    ?? null,
};

const featuredProjects = [
  {
    title: "Modaryn",
    slug: "modaryn",
    description: "Analyzes dbt projects to score model complexity and structural importance.",
    link: "https://github.com/yujikawa/modaryn",
    tags: ["Python", "dbt", "CLI"],
  },
  {
    title: "Modscape",
    slug: "modscape",
    description: "A YAML-driven data modeling visualizer bridging conceptual and physical models.",
    link: "https://github.com/yujikawa/modscape",
    tags: ["TypeScript", "YAML", "Data Modeling"],
  },
];

const skills = ["dbt", "SQL", "Python", "BigQuery", "Snowflake", "Spark", "Airflow"];

const tabs = [
  { id: "skills",   file: "skills.sql",   rows: "5 rows" },
  { id: "activity", file: "activity.sql",  rows: "365 rows" },
  { id: "writing",  file: "writing.sql",   rows: "3 rows" },
  { id: "projects", file: "projects.sql",  rows: "2 rows" },
];
---

<Layout title="mypage.sql">

<style>
  /* ── IDE window ── */
  .ide-window {
    display: flex;
    flex-direction: column;
    background: #0d1117;
    border: 1px solid #30363d;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 32px 80px rgba(0,0,0,0.7), 0 0 0 1px rgba(255,255,255,0.03);
  }

  /* ── Header ── */
  .ide-header {
    display: flex;
    align-items: center;
    gap: 0;
    padding: 0 12px;
    height: 42px;
    background: #161b22;
    border-bottom: 1px solid #21262d;
    flex-shrink: 0;
    user-select: none;
  }
  .header-brand {
    display: flex;
    align-items: center;
    gap: 7px;
    padding-right: 20px;
    border-right: 1px solid rgba(33,38,45,.8);
    margin-right: 4px;
    flex-shrink: 0;
  }
  .menu-item {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    color: rgba(139,148,158,.4);
    padding: 4px 10px;
    border-radius: 4px;
    cursor: default;
    transition: background .15s, color .15s;
    white-space: nowrap;
  }
  .menu-item:hover { background: rgba(255,255,255,.05); color: rgba(139,148,158,.75); }

  /* ── Editor + ER split ── */
  .ide-body {
    display: flex;
    flex: 1;
    overflow: hidden;
    min-height: 0;
  }

  /* ── Editor pane ── */
  .ide-editor-pane {
    display: flex;
    flex-direction: column;
    border-right: 1px solid #21262d;
    min-width: 0;
    width: 44%;
    flex-shrink: 0;
  }

  /* ── Tab bar ── */
  .ide-tabbar {
    display: flex;
    align-items: flex-end;
    background: #0d1117;
    border-bottom: 1px solid #21262d;
    overflow-x: auto;
    flex-shrink: 0;
    scrollbar-width: none;
  }
  .ide-tabbar::-webkit-scrollbar { display: none; }

  .ide-tab {
    display: flex;
    align-items: center;
    gap: 5px;
    padding: 6px 14px 7px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    color: rgba(139,148,158,.4);
    border-top: 1px solid transparent;
    border-right: 1px solid transparent;
    border-left: 1px solid transparent;
    cursor: pointer;
    white-space: nowrap;
    transition: color .15s, background .15s;
    background: transparent;
    position: relative;
    top: 1px;
    border-radius: 4px 4px 0 0;
  }
  .ide-tab:hover { color: rgba(139,148,158,.65); background: rgba(255,255,255,.03); }
  .ide-tab.active {
    color: #f0f0f0;
    background: #0d1117;
    border-color: #30363d;
    border-bottom-color: #0d1117;
  }
  .ide-tab.active .tab-dot { color: #3b82f6; }

  /* ── SQL Editor lines ── */
  .ide-editor-scroll {
    flex: 1;
    overflow-y: auto;
    background: #0d1117;
    scrollbar-width: thin;
    scrollbar-color: #30363d transparent;
  }
  .ide-editor-scroll::-webkit-scrollbar { width: 6px; }
  .ide-editor-scroll::-webkit-scrollbar-track { background: transparent; }
  .ide-editor-scroll::-webkit-scrollbar-thumb { background: #30363d; border-radius: 3px; }

  .ide-editor-content { display: none; padding-bottom: 16px; }
  .ide-editor-content.active { display: block; }

  .sql-line {
    display: flex;
    line-height: 1.7;
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
  }
  .sql-line:hover { background: rgba(255,255,255,.025); }
  .sql-line.highlighted { background: rgba(59,130,246,.06); }

  .ln {
    width: 44px;
    text-align: right;
    padding-right: 16px;
    color: rgba(139,148,158,.22);
    flex-shrink: 0;
    user-select: none;
  }
  .lc { padding-right: 16px; color: rgba(240,240,240,.85); flex: 1; }

  /* blinking cursor */
  .sql-cursor {
    display: inline-block;
    width: 2px;
    height: 14px;
    background: #3b82f6;
    vertical-align: text-bottom;
    animation: blink 1.1s step-end infinite;
    border-radius: 1px;
  }
  @keyframes blink { 50% { opacity: 0; } }

  /* ── Editor footer ── */
  .ide-editor-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 5px 10px;
    background: #161b22;
    border-top: 1px solid #21262d;
    flex-shrink: 0;
  }

  /* ── Run button ── */
  .run-btn {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 4px 12px;
    background: rgba(59,130,246,.15);
    border: 1px solid rgba(59,130,246,.3);
    border-radius: 5px;
    color: rgba(59,130,246,.85);
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    cursor: pointer;
    transition: background .15s, transform .1s;
  }
  .run-btn:hover { background: rgba(59,130,246,.25); }
  .run-btn:active { transform: scale(.96); }
  .run-btn.running { opacity: .6; pointer-events: none; }

  /* ── ER pane ── */
  .ide-er-pane {
    display: flex;
    flex-direction: column;
    flex: 1;
    min-width: 0;
    background: #090d12;
  }
  .ide-panel-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 5px 12px;
    background: #0d1117;
    border-bottom: 1px solid #21262d;
    flex-shrink: 0;
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px;
    color: rgba(139,148,158,.4);
  }
  .ide-er-scroll {
    flex: 1;
    overflow: auto;
    position: relative;
    background-image: radial-gradient(circle, #1e2530 1px, transparent 1px);
    background-size: 20px 20px;
    scrollbar-width: thin;
    scrollbar-color: #30363d transparent;
  }

  /* ── View toggle ── */
  .view-toggle {
    display: flex;
    gap: 2px;
    background: rgba(0,0,0,.3);
    border: 1px solid rgba(255,255,255,.06);
    border-radius: 5px;
    padding: 2px;
  }
  .view-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 20px;
    border-radius: 3px;
    cursor: pointer;
    color: rgba(139,148,158,.35);
    transition: background .12s, color .12s;
    border: none;
    background: transparent;
  }
  .view-btn:hover { color: rgba(139,148,158,.7); }
  .view-btn.active { background: rgba(59,130,246,.2); color: rgba(59,130,246,.85); }

  .result-view { display: none; }
  .result-view.active { display: block; }
  .result-view-card.active { display: flex; }

  /* ── Panel divider (cosmetic resize handle) ── */
  .ide-divider {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 4px 12px;
    background: #161b22;
    border-top: 1px solid #21262d;
    border-bottom: 1px solid #21262d;
    flex-shrink: 0;
    cursor: row-resize;
    user-select: none;
  }
  .divider-dots { display: flex; gap: 2px; }
  .divider-dot { width: 14px; height: 2px; background: rgba(139,148,158,.12); border-radius: 1px; }

  /* ── Results pane ── */
  .ide-results-pane {
    display: flex;
    flex-direction: column;
    background: #0d1117;
    flex-shrink: 0;
    height: 34%;
    min-height: 160px;
    max-height: 48%;
  }

  .ide-result-content { display: none; }
  .ide-result-content.visible {
    display: block;
    animation: resultIn .4s ease forwards;
  }
  @keyframes resultIn {
    from { opacity: 0; transform: translateY(8px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  .result-table { width: 100%; border-collapse: collapse; }
  .result-table th {
    text-align: left;
    padding: 7px 14px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px;
    font-weight: normal;
    color: rgba(139,148,158,.5);
    background: #161b22;
    border-bottom: 1px solid #21262d;
    position: sticky;
    top: 0;
    z-index: 1;
  }
  .result-table td {
    padding: 6px 14px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    border-bottom: 1px solid rgba(33,38,45,.5);
    transition: background .1s;
  }
  .result-table tr:hover td { background: rgba(255,255,255,.02); }
  .row-num { color: rgba(139,148,158,.2); width: 36px; }

  /* ── Status bar ── */
  .ide-statusbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 4px 12px;
    background: rgba(59,130,246,.12);
    border-top: 1px solid rgba(59,130,246,.2);
    flex-shrink: 0;
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px;
  }

  /* ── Empty state ── */
  .results-empty {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100%;
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    color: rgba(139,148,158,.2);
  }

  /* ── Explorer pane (leftmost) ── */
  .ide-explorer-pane {
    display: flex;
    flex-direction: column;
    width: 168px;
    flex-shrink: 0;
    border-right: 1px solid #21262d;
    background: #0d1117;
    overflow: hidden;
  }
  .ide-explorer-scroll {
    flex: 1;
    overflow-y: auto;
    scrollbar-width: thin;
    scrollbar-color: #30363d transparent;
  }
  .explorer-section {
    padding: 6px 0 2px;
  }
  .explorer-section-label {
    display: flex;
    align-items: center;
    gap: 4px;
    padding: 3px 10px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 9px;
    color: rgba(139,148,158,.3);
    text-transform: uppercase;
    letter-spacing: .06em;
    user-select: none;
  }
  .explorer-item {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 4px 10px 4px 18px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px;
    color: rgba(139,148,158,.5);
    cursor: pointer;
    transition: background .12s, color .12s;
    border-left: 2px solid transparent;
  }
  .explorer-item:hover { background: rgba(255,255,255,.04); color: rgba(139,148,158,.8); }
  .explorer-item.active {
    color: #9cdcfe;
    background: rgba(59,130,246,.08);
    border-left-color: #3b82f6;
  }
  .explorer-item.fact {
    color: rgba(86,156,214,.7);
    cursor: default;
    border-left: 2px solid rgba(59,130,246,.3);
    background: rgba(59,130,246,.04);
  }
  .explorer-item .ei-icon { font-size: 8px; flex-shrink: 0; }

  /* ── Profile popup ── */
  .profile-popup {
    position: absolute;
    top: calc(100% + 6px);
    right: 0;
    width: 200px;
    border-radius: 8px;
    border: 1px solid #30363d;
    background: #161b22;
    overflow: hidden;
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px;
    z-index: 100;
    box-shadow: 0 12px 40px rgba(0,0,0,.7), 0 0 0 1px rgba(255,255,255,.04);
    opacity: 0;
    transform: translateY(-4px) scale(.98);
    pointer-events: none;
    transition: opacity .18s ease, transform .18s ease;
  }
  .profile-popup.open {
    opacity: 1;
    transform: translateY(0) scale(1);
    pointer-events: auto;
  }
  .profile-trigger {
    position: relative;
    display: flex;
    align-items: center;
    gap: 6px;
    cursor: pointer;
    padding: 2px 4px;
    border-radius: 5px;
    transition: background .15s;
  }
  .profile-trigger:hover { background: rgba(255,255,255,.06); }

  /* ── Mobile layout ── */
  @media (max-width: 767px) {
    /* IDE window: auto height (scroll instead of fixed viewport) */
    .ide-window { height: auto !important; min-height: unset !important; }

    /* Body: vertical stack */
    .ide-body {
      flex-direction: column;
      overflow: visible;
      min-height: 0;
    }

    /* Hide explorer */
    .ide-explorer-pane { display: none; }

    /* ER diagram: top, fixed height */
    .ide-er-pane {
      order: 1;
      width: 100%;
      height: 300px;
      flex-shrink: 0;
      border-right: none;
      border-bottom: 1px solid #21262d;
    }

    /* SQL editor: middle */
    .ide-editor-pane {
      order: 2;
      width: 100%;
      height: auto;
      min-height: 160px;
      flex-shrink: 0;
      border-right: none;
      border-bottom: 1px solid #21262d;
    }
    .ide-editor-scroll { max-height: 200px; }

    /* Results: bottom, auto height */
    .ide-results-pane {
      order: 3;
      height: auto;
      max-height: none;
      min-height: 200px;
      flex-shrink: 0;
    }

    /* Menu bar: hide less important items */
    .menu-item:nth-child(n+4) { display: none; }
  }
</style>

<main class="px-3 sm:px-4 pb-4 pt-4">

  <div class="ide-window" id="ide-window" style="height: calc(100vh - 2rem); min-height: 580px;">

    <!-- ── Header ── -->
    <div class="ide-header">
      <!-- Brand -->
      <div class="header-brand">
        <svg viewBox="0 0 16 16" style="width:14px;height:14px;fill:rgba(59,130,246,.6);flex-shrink:0;">
          <path d="M2 2.5A2.5 2.5 0 014.5 0h8.75a.75.75 0 01.75.75v12.5a.75.75 0 01-.75.75h-2.5a.75.75 0 110-1.5h1.75v-2h-8a1 1 0 00-.714 1.7.75.75 0 01-1.072 1.05A2.495 2.495 0 012 11.5v-9zm10.5-1V9h-8c-.356 0-.694.074-1 .208V2.5a1 1 0 011-1h8z"/>
        </svg>
        <span class="mono" style="font-size:12px;color:rgba(240,240,240,.6);font-weight:500;">mypage.sql</span>
      </div>
      <!-- Menu items -->
      {["File", "Edit", "View", "Run", "Help"].map(item => (
        <button class="menu-item">{item}</button>
      ))}
      <!-- Spacer -->
      <div style="flex:1;"></div>
      <!-- Online badge -->
      <div style="display:flex;align-items:center;gap:5px;margin-right:14px;padding-right:14px;border-right:1px solid rgba(33,38,45,.8);">
        <span style="width:5px;height:5px;border-radius:50%;background:#34d399;display:inline-block;flex-shrink:0;"></span>
        <span class="mono" style="font-size:10px;color:rgba(139,148,158,.3);">Analytics Engineer</span>
      </div>
      <!-- Profile trigger -->
      <div style="position:relative;">
        <div class="profile-trigger" id="profile-trigger">
          <img src="/mypage/icon.png" alt="Yuji" style="width:22px;height:22px;border-radius:50%;border:1px solid rgba(59,130,246,.25);object-fit:cover;" />
          <span class="mono" style="font-size:11px;color:rgba(139,148,158,.5);">Yuji</span>
          <svg viewBox="0 0 10 6" style="width:8px;height:8px;fill:none;stroke:rgba(139,148,158,.3);stroke-width:1.5;flex-shrink:0;"><path d="M1 1l4 4 4-4"/></svg>
        </div>
        <!-- Profile popup -->
        <div class="profile-popup" id="profile-popup">
          <div style="padding:7px 10px;border-bottom:1px solid rgba(33,38,45,.7);display:flex;align-items:center;gap:6px;">
            <span style="width:6px;height:6px;border-radius:50%;background:#34d399;display:inline-block;flex-shrink:0;"></span>
            <span style="color:rgba(52,211,153,.7);">active</span>
            <span style="margin-left:auto;color:rgba(139,148,158,.25);">engineers · id:1</span>
          </div>
          <div style="padding:10px;display:flex;align-items:center;gap:9px;border-bottom:1px solid rgba(33,38,45,.5);">
            <div style="position:relative;flex-shrink:0;">
              <img src="/mypage/icon.png" alt="Yuji" style="width:36px;height:36px;border-radius:50%;border:1px solid rgba(59,130,246,.25);object-fit:cover;" />
              <div style="position:absolute;bottom:0;right:0;width:9px;height:9px;border-radius:50%;background:#34d399;border:1.5px solid #161b22;"></div>
            </div>
            <div>
              <div style="color:#f0f0f0;font-weight:700;font-size:12px;">Yuji</div>
              <div style="color:rgba(139,148,158,.4);font-size:9px;margin-top:1px;">Analytics Engineer</div>
              <div style="color:rgba(139,148,158,.3);font-size:9px;">Japan</div>
            </div>
          </div>
          <div style="padding:8px 10px;border-bottom:1px solid rgba(33,38,45,.5);">
            {[
              { col: "name",     val: "'Yuji'",             },
              { col: "role",     val: "'Analytics Eng'",   },
              { col: "location", val: "'Japan'",           },
              { col: "passion",  val: "'biz users + data'" },
            ].map(({ col, val }) => (
              <div style="display:flex;align-items:center;gap:6px;line-height:1.8;">
                <span style="color:#9cdcfe;width:46px;flex-shrink:0;font-size:9px;">{col}</span>
                <span style="color:rgba(139,148,158,.35);font-size:9px;">│</span>
                <span style="color:#ce9178;font-size:9px;truncate;">{val}</span>
              </div>
            ))}
          </div>
          <div style="padding:8px 10px;display:flex;flex-wrap:wrap;gap:3px;border-bottom:1px solid rgba(33,38,45,.5);">
            {skills.map(skill => (
              <span style="padding:1px 5px;color:rgba(59,130,246,.65);background:rgba(59,130,246,.08);border:1px solid rgba(59,130,246,.2);border-radius:3px;font-size:8px;">{skill}</span>
            ))}
          </div>
          <div style="padding:7px 10px;display:flex;gap:5px;">
            <a href="https://github.com/yujikawa" target="_blank" rel="noopener noreferrer" style="flex:1;display:flex;align-items:center;justify-content:center;gap:3px;padding:5px;border-radius:4px;border:1px solid rgba(48,54,61,.5);color:rgba(139,148,158,.45);font-size:9px;text-decoration:none;transition:color .15s,border-color .15s;" onmouseover="this.style.color='rgba(139,148,158,.8)'" onmouseout="this.style.color='rgba(139,148,158,.45)'">
              <svg viewBox="0 0 16 16" style="width:9px;height:9px;" fill="currentColor"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38C13.71 14.53 16 11.54 16 8c0-4.42-3.58-8-8-8z"/></svg>
              GitHub
            </a>
            <a href="https://medium.com/@yujikawa" target="_blank" rel="noopener noreferrer" style="flex:1;display:flex;align-items:center;justify-content:center;padding:5px;border-radius:4px;border:1px solid rgba(48,54,61,.5);color:rgba(139,148,158,.45);font-size:9px;text-decoration:none;transition:color .15s;" onmouseover="this.style.color='rgba(139,148,158,.8)'" onmouseout="this.style.color='rgba(139,148,158,.45)'">
              Medium
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- ── Editor + ER ── -->
    <div class="ide-body">

      <!-- LEFTMOST: Explorer Pane -->
      <div class="ide-explorer-pane">
        <div class="ide-panel-header">
          <span style="display:flex;align-items:center;gap:5px;">
            <svg viewBox="0 0 16 16" style="width:10px;height:10px;fill:rgba(139,148,158,.4);"><path d="M1 2.5A1.5 1.5 0 012.5 1h3A1.5 1.5 0 017 2.5v3A1.5 1.5 0 015.5 7h-3A1.5 1.5 0 011 5.5v-3zm8 0A1.5 1.5 0 0110.5 1h3A1.5 1.5 0 0115 2.5v3A1.5 1.5 0 0113.5 7h-3A1.5 1.5 0 019 5.5v-3zm-8 8A1.5 1.5 0 012.5 9h3A1.5 1.5 0 017 10.5v3A1.5 1.5 0 015.5 15h-3A1.5 1.5 0 011 13.5v-3zm8 0A1.5 1.5 0 0110.5 9h3A1.5 1.5 0 0115 10.5v3A1.5 1.5 0 0113.5 15h-3A1.5 1.5 0 019 13.5v-3z"/></svg>
            Explorer
          </span>
        </div>
